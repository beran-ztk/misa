<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Music.Views.MainWindow"
        Title="Misa"
        Width="1300" Height="760"
        MinWidth="900" MinHeight="520"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">

    <Grid RowDefinitions="38,*">

        <!-- ══ Custom title bar ══ -->
        <Border Grid.Row="0" 
                BorderBrush="SteelBlue"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">

                    <!-- Drag / title area (transparent so hit-testable, but invisible) -->
                    <Panel Grid.Column="0"
                           Background="Transparent"
                           PointerPressed="OnTitleBarPointerPressed"
                           DoubleTapped="OnTitleBarDoubleTapped">
                            <TextBlock Text="Music Library"
                                       Foreground="LavenderBlush"
                                       Margin="10,0,0,0"
                                       FontSize="14" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                    </Panel>

                    <!-- Window control buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        
                        <Button Content="─"
                                Click="OnMinimizeClicked"
                                Width="46" Height="38" Padding="0"
                                FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Opacity="0.6"/>
                        <Button x:Name="TitleMaxBtn"
                                Content="□"
                                Click="OnMaxRestoreClicked"
                                Width="46" Height="38" Padding="0"
                                FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Opacity="0.6"/>
                        <Button Content="✕"
                                Click="OnWindowCloseClicked"
                                Width="46" Height="38" Padding="0"
                                FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Opacity="0.6"/>
                    </StackPanel>
                </Grid>
        </Border>

        <!-- ══ Content area ══ -->
        <ContentControl Grid.Row="1" 
                        x:Name="ContentArea"/>

    </Grid>

</Window>
