<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.SettingsOverlay">

    <UserControl.Styles>
        <Style Selector="ToggleButton.settings-nav">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="#A7AFB9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:pointerover">
            <Setter Property="Background" Value="#5A25282E"/>
            <Setter Property="Foreground" Value="#EDF1F5"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:checked">
            <Setter Property="Background" Value="#8030333B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#7A080B0F"/>
            <Setter Property="BorderBrush" Value="#314151"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#7A080B0F"/>
            <Setter Property="BorderBrush" Value="#314151"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings-action">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#25313B"/>
            <Setter Property="BorderBrush" Value="#3A4C5D"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings-ghost">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#334455"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="244,1,*" Background="#EA0B0D10">
        <!-- Settings navigation -->
        <Border Grid.Column="0" Background="#B0090B0E" Padding="16,20,16,16">
            <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Library setup" FontSize="11" Opacity="0.52"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,26,0,0" Spacing="6">
                    <TextBlock Text="CLASSIFICATION" FontSize="10" FontWeight="SemiBold"
                               Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                    <ToggleButton x:Name="GenreVocabularyNavButton" Classes="settings-nav"
                                  Content="Genres" Tag="mappings"
                                  Click="OnSettingsNavigationClicked"/>
                    <ToggleButton x:Name="AnalysisCalibrationNavButton" Classes="settings-nav"
                                  IsVisible="False"
                                  Content="Analysis calibration" Tag="calibration"
                                  Click="OnSettingsNavigationClicked"/>
                    <ToggleButton x:Name="TagsNavButton" Classes="settings-nav"
                                  Content="Tags" Tag="tags"
                                  Click="OnSettingsNavigationClicked"/>
                    <ToggleButton x:Name="TagRulesNavButton" Classes="settings-nav"
                                  IsVisible="False"
                                  Content="Tag rules" Tag="tag_rules"
                                  Click="OnSettingsNavigationClicked"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,22,0,0" Spacing="6">
                    <TextBlock Text="LIBRARY" FontSize="10" FontWeight="SemiBold"
                               Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                    <ToggleButton x:Name="LibraryNavButton" Classes="settings-nav"
                                  Content="Locations" Tag="library"
                                  Click="OnSettingsNavigationClicked"/>
                    <ToggleButton x:Name="ExportNavButton" Classes="settings-nav"
                                  Content="Export" Tag="export"
                                  Click="OnSettingsNavigationClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <Rectangle Grid.Column="1" Fill="#1F808080"/>

        <!-- Settings content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,1,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="30,20,22,16">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageDescriptionText" FontSize="11" Opacity="0.58" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Click="OnCloseClicked"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0.65"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Close">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#18808080"/>

            <Grid x:Name="GenreVocabularyPage" Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="30,22,30,0">
                <Border Grid.Row="0"
                        Background="#52080B0F"
                        BorderBrush="#263542"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,210" ColumnSpacing="10">
                        <TextBox x:Name="SearchBox" Classes="settings-input"
                                 Watermark="Search subgenres…"/>
                        <ComboBox x:Name="ModelGenreBox" Grid.Column="1" Classes="settings-input"/>
                    </Grid>
                </Border>

                <Border x:Name="AddSubgenrePanel"
                        Grid.Row="1"
                        IsVisible="False"
                        Background="#360A1016"
                        BorderBrush="#263542"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AddSubgenreTitleText" Text="Add subgenre" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Create a new subgenre in the selected model category."
                                       FontSize="10.5" Opacity="0.56"/>
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="NewSubgenreBox" Classes="settings-input"
                                     Watermark="New subgenre name…"/>
                            <Button Grid.Column="1" Classes="settings-action"
                                    Content="Add subgenre"
                                    Click="OnAddSubgenreClicked"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="GENRE VOCABULARY" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock x:Name="GenreVocabularyHintText"
                                   Grid.Column="1"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GenreVocabularyRows" Spacing="8" Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="LibraryPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Library locations" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="The local database and downloaded tracks used by this installation."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="DATABASE" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock x:Name="DatabasePathText" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="TRACKS FOLDER" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock x:Name="TracksPathText" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ExportPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Portable export" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Create a portable copy of the current music library, including audio files, covers, and metadata for external devices."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="Export Android library"
                            Click="OnExportRequestedClicked"
                            HorizontalAlignment="Left"
                            Padding="14,7"
                            Background="#26313A"
                            BorderBrush="#425365"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AnalysisCalibrationPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="Compare system interpretations with their strongest evidence. Click a row to review the track."
                               FontSize="11" Opacity="0.62" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CalibrationSortBox" Grid.Column="1" Width="170" Height="32"/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CalibrationRows" Spacing="5" Margin="0,0,0,18"/>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TagsPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="30,22,30,0">
                <Border Grid.Row="0"
                        Background="#52080B0F"
                        BorderBrush="#263542"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
                        <ComboBox x:Name="TagCategoryBox" Classes="settings-input"
                                  SelectionChanged="OnTagCategorySelectionChanged"/>
                        <TextBox x:Name="NewTagCategoryBox" Grid.Column="1" Classes="settings-input"
                                 Watermark="New tag category…"/>
                        <Button Grid.Column="2" Classes="settings-action"
                                Content="Add category"
                                Click="OnAddTagCategoryClicked"/>
                    </Grid>
                </Border>

                <Border x:Name="AddTagPanel"
                        Grid.Row="1"
                        IsVisible="False"
                        Background="#360A1016"
                        BorderBrush="#263542"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="AddTagTitleText" Text="Add tag" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Create a tag inside the selected category."
                                           FontSize="10.5" Opacity="0.56"/>
                            </StackPanel>
                            <TextBox x:Name="TagCategoryColorBox"
                                     Grid.Column="1"
                                     Classes="settings-input"
                                     Width="105"
                                     Watermark="#65BCEB"/>
                            <Button Grid.Column="2"
                                    Classes="settings-action"
                                    Content="Save color"
                                    Click="OnSaveTagCategoryColorClicked"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="190,*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="NewTagBox" Classes="settings-input"
                                     Watermark="New tag…"/>
                            <TextBox x:Name="NewTagDescriptionBox" Grid.Column="1" Classes="settings-input"
                                     Watermark="Description / usage hint…"/>
                            <Button Grid.Column="2" Classes="settings-action"
                                    Content="Add tag"
                                    Click="OnAddTagClicked"/>
                        </Grid>
                    </Grid>
                </Border>

                <TextBox x:Name="RenameTagCategoryBox" IsVisible="False"/>

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="TAGS" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock x:Name="TagVocabularyHintText"
                                   Grid.Column="1"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TagRows" Spacing="8" Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="TagRulesPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.Row="0" ColumnDefinitions="170,88,165,*,86,Auto" ColumnSpacing="10" Margin="0,0,0,14">
                    <ComboBox x:Name="TagRuleTagBox" Height="34"/>
                    <ComboBox x:Name="TagRuleMatchModeBox" Grid.Column="1" Height="34"/>
                    <ComboBox x:Name="TagRuleModelBox" Grid.Column="2" Height="34"
                              SelectionChanged="OnTagRuleModelSelectionChanged"/>
                    <ComboBox x:Name="TagRuleSignalBox" Grid.Column="3" Height="34"/>
                    <TextBox x:Name="TagRuleThresholdBox" Grid.Column="4" Height="34"
                             Text="0.30" Watermark="Score"/>
                    <Button Grid.Column="5" Content="Create rule" Click="OnAddTagRuleClicked"
                            Padding="12,5"/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TagRuleRows" Spacing="5" Margin="0,0,0,18"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#24272E" Padding="30,10,30,13">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="11" Opacity="0.65"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
