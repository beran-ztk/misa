<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.ImportOverlay">
    <Panel>
        <Border Background="#78000000" PointerPressed="OnBackdropPressed"/>
        <Border Width="400" MaxWidth="460" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1E1E1E" BorderBrush="#314B5F" BorderThickness="1"
                CornerRadius="8" BoxShadow="0 8 40 4 #80000000" Padding="24">
            <Grid>
                <StackPanel x:Name="ImportForm" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <TextBlock Text="Download from YouTube" FontSize="18" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="✕" Click="OnCloseClicked" Padding="8,3"
                                FontSize="13" Opacity="0.6"/>
                    </Grid>
                    <TextBlock Text="Paste a YouTube URL" FontSize="12" Opacity="0.62"/>
                    <TextBox x:Name="UrlBox" Watermark="https://www.youtube.com/watch?v=…"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.72" TextWrapping="Wrap"/>
                    <StackPanel x:Name="BusyPanel" IsVisible="False" Spacing="7" Margin="0,8,0,0">
                        <TextBlock x:Name="BusyText" Text="Downloading audio…" FontSize="12" FontWeight="SemiBold"/>
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Foreground="#1E9AF0" Background="#26313A"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
