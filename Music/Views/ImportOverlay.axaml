<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.ImportOverlay"
             Background="#D21B1914">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#C82A261D" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="Import queue" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Build an import plan, then let downloads and analysis run in the background."
                               FontSize="11" Opacity="0.62"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="OnCloseClicked" Classes="icon" ToolTip.Tip="Close queue" Opacity="0.7"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="410,*" ColumnSpacing="28" Margin="26,22,26,32">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="ADD LINKS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                        <TextBlock Text="Videos, playlists and YouTube mixes are expanded before anything is queued."
                                   FontSize="11" Opacity="0.66" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="InputUrlBox"
                             Watermark="Paste a YouTube video, playlist or mix link…"
                             FontSize="11"
                             MinHeight="34"
                             VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <TextBlock Text="CHECKED LINKS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                        <TextBlock x:Name="EmptyPreviewText" Text="Paste a link above to check it automatically."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        <StackPanel x:Name="PendingPreviewRows" Spacing="8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="QueueHeaderText" Text="CURRENT QUEUE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                        <TextBlock Text="Queued and failed imports can be removed. Finished tracks leave this list automatically."
                                   FontSize="11" Opacity="0.66"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyQueueText" Text="Nothing is waiting yet." FontSize="12" Opacity="0.5" Margin="0,14,0,0"/>
                    <StackPanel x:Name="QueueSources" Spacing="10"/>
                    <StackPanel Spacing="3" Margin="0,12,0,0">
                        <TextBlock x:Name="AnalysisQueueHeaderText" Text="ANALYSIS QUEUE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                        <TextBlock Text="Downloaded tracks waiting for model data."
                                   FontSize="11" Opacity="0.66"/>
                    </StackPanel>
                    <Border x:Name="AnalysisServerUnavailablePanel"
                            IsVisible="False"
                            Background="#341D1717"
                            BorderBrush="#7A4343"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="AnalysisServerUnavailableText"
                                       Text="Server currently unavailable."
                                       FontSize="11"
                                       Foreground="#E8A0A0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RetryAnalysisServerButton"
                                    Grid.Column="1"
                                    Content="Reconnect"
                                    FontSize="10"
                                    Padding="9,4"
                                    Click="OnRetryAnalysisServerClicked"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="EmptyAnalysisQueueText" Text="No analysis pending." FontSize="12" Opacity="0.5"/>
                    <StackPanel x:Name="AnalysisQueueRows" Spacing="6"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
