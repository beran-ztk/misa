<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.ImportOverlay">
    <Panel>
        <Border Background="#70000000"/>
        <Border Width="400" MaxWidth="460" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1E1E1E" BorderBrush="#314B5F" BorderThickness="1"
                CornerRadius="8" BoxShadow="0 8 40 4 #80000000" Padding="24">
            <Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <TextBlock Text="Download from YouTube" FontSize="18" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="✕" Click="OnCloseClicked" Padding="8,3"
                                FontSize="13" Opacity="0.6"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Text="Paste a YouTube URL" FontSize="12" Opacity="0.62"/>
                        <TextBox x:Name="UrlBox" Watermark="https://www.youtube.com/watch?v=…"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.72" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="BusyLayer" IsVisible="False" Background="#C008111A" CornerRadius="8">
                    <Border Width="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#101821" BorderBrush="#315672" BorderThickness="1"
                            CornerRadius="8" Padding="22,18" BoxShadow="0 8 28 2 #66000000">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="BusyText" Text="Downloading audio…" FontSize="15" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Height="5"
                                         Foreground="#1E9AF0" Background="#26313A"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
