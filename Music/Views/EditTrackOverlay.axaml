<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.EditTrackOverlay">

    <Panel>

        <Border Background="#70000000" />

        <Border Margin="32,16,32,16"
                MaxWidth="880" MinWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#1E1E1E"
                CornerRadius="8"
                BoxShadow="0 8 40 4 #80000000">

            <Grid RowDefinitions="Auto,1,*,1,Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="24,16,20,14">
                    <TextBlock Grid.Column="0"
                               Text="Edit Track"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="OnCloseClicked"
                            Padding="8,4" FontSize="13"
                            Opacity="0.55"
                            VerticalAlignment="Center" />
                </Grid>

                <Rectangle Grid.Row="1" Fill="#18808080" />

                <ScrollViewer Grid.Row="2"
                              Padding="24,18,24,0"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="22" Margin="0,0,0,20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="Title"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBox x:Name="TitleBox" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rating"
                                       FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="RatingBox" MinWidth="200" />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,0,40,0">
                            <TextBlock Text="Genres"
                                       FontSize="13" FontWeight="SemiBold" />
                            <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                        </StackPanel>

                        <StackPanel x:Name="ModelAnalysisSection" Spacing="7" Margin="0,0,40,0">
                            <TextBlock Text="Model analysis"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModelPredictionsText"
                                       FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="AudioAnalysisSection" Spacing="7" Margin="0,0,40,0">
                            <TextBlock Text="Audio analysis"
                                       FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="BPM" FontSize="11" Opacity="0.62"/>
                                <TextBlock x:Name="BpmText" Grid.Column="1" FontSize="11"/>
                                <TextBlock Grid.Row="1" Text="Integrated loudness" FontSize="11" Opacity="0.62"/>
                                <TextBlock x:Name="IntegratedLoudnessText" Grid.Row="1" Grid.Column="1" FontSize="11"/>
                                <TextBlock Grid.Row="2" Text="Loudness range" FontSize="11" Opacity="0.62"/>
                                <TextBlock x:Name="LoudnessRangeText" Grid.Row="2" Grid.Column="1" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="StylesSection" ColumnDefinitions="Auto,*" Margin="0,0,40,0">
                            <Border Grid.Column="0"
                                    Width="2" Margin="0,2,0,2"
                                    Background="#40808080" CornerRadius="1" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Styles"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="optional"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Grid>

                        <Border Height="10" />
                    </StackPanel>
                </ScrollViewer>

                <Rectangle Grid.Row="3" Fill="#18808080" />

                <Grid Grid.Row="4"
                      ColumnDefinitions="*,Auto"
                      Margin="24,10,24,16">
                    <TextBlock Grid.Column="0"
                               x:Name="StatusText"
                               Text="" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.65"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveBtn"
                                Content="Save"
                                Click="OnSaveClicked"
                                IsEnabled="False"
                                Classes="accent" />
                        <Button Content="Cancel"
                                Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="5"
                        IsVisible="False"
                        Background="#C0181A1D"
                        CornerRadius="8">
                    <StackPanel Width="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <TextBlock Text="Analyzing genres with Discogs-MAEST…"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="5"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

    </Panel>

</UserControl>
