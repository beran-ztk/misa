<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.EditTrackOverlay">

    <Panel>

        <Border Background="#70000000" />

        <Border Margin="32,16,32,16"
                MaxWidth="880" MinWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#1E1E1E"
                CornerRadius="8"
                PointerPressed="OnEditorPressed"
                BoxShadow="0 8 40 4 #80000000">

            <Grid RowDefinitions="Auto,1,*,1,Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="24,16,20,14">
                    <TextBlock Grid.Column="0"
                               Text="Edit Track"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AnalysisButton"
                                Content="Analysis"
                                Click="OnAnalysisButtonClicked"
                                Padding="10,4" FontSize="11"
                                IsVisible="False"
                                Opacity="0.72" />
                        <Button Content="✕"
                                Click="OnCloseClicked"
                                Padding="8,4" FontSize="13"
                                Opacity="0.55"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#18808080" />

                <ScrollViewer Grid.Row="2"
                              Padding="24,18,24,0"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="22" Margin="0,0,0,20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="Title"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBox x:Name="TitleBox" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rating"
                                       FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="RatingBox" MinWidth="200" />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,0,40,0">
                            <StackPanel x:Name="ModelSelectedGenresSection" Spacing="7" Margin="0,0,0,18">
                                <TextBlock Text="Model-selected genres" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel x:Name="ModelSelectedGenresPanel" Spacing="8" />
                            </StackPanel>
                            <TextBlock Text="Genres"
                                       FontSize="13" FontWeight="SemiBold" />
                            <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                        </StackPanel>

                        <StackPanel x:Name="AudioAnalysisSection" Spacing="7" Margin="0,0,40,0">
                            <TextBlock Text="Audio analysis"
                                       FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Spacing="6">
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Tempo" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BpmText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BpmInsightText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="10.5" Opacity="0.65" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Integrated loudness" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="IntegratedLoudnessText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="IntegratedLoudnessInsightText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="10.5" Opacity="0.65" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Loudness range" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LoudnessRangeText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LoudnessRangeInsightText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="10.5" Opacity="0.65" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SoundProfileSection" Spacing="8" Margin="0,0,40,0">
                            <TextBlock Text="Sound profile" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="SoundProfilePanel" Spacing="7" />
                        </StackPanel>

                        <Grid x:Name="StylesSection" ColumnDefinitions="Auto,*" Margin="0,0,40,0">
                            <Border Grid.Column="0"
                                    Width="2" Margin="0,2,0,2"
                                    Background="#40808080" CornerRadius="1" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Styles"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="optional"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Grid>

                        <Border Height="10" />
                    </StackPanel>
                </ScrollViewer>

                <Rectangle Grid.Row="3" Fill="#18808080" />

                <Grid Grid.Row="4"
                      ColumnDefinitions="*,Auto"
                      Margin="24,10,24,16">
                    <TextBlock Grid.Column="0"
                               x:Name="StatusText"
                               Text="" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.65"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveBtn"
                                Content="Save"
                                Click="OnSaveClicked"
                                IsEnabled="False"
                                Classes="accent" />
                        <Button Content="Cancel"
                                Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="5"
                        IsVisible="False"
                        Background="#C0181A1D"
                        CornerRadius="8">
                    <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#101A27" BorderBrush="#36779F" BorderThickness="1" CornerRadius="9" Padding="24,20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Analyzing track…" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Height="5" Foreground="#1E9AF0" Background="#26313A"/>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

        <Popup x:Name="AnalysisPopup"
               PlacementTarget="{Binding #AnalysisButton}"
               Placement="Bottom">
            <Border Width="380" Margin="0,8,0,0" Padding="14,12"
                    Background="#18212B" BorderBrush="#3A6784" BorderThickness="1"
                    CornerRadius="7" BoxShadow="0 8 24 2 #80000000">
                <StackPanel Spacing="7">
                    <TextBlock Text="Model analysis" FontSize="12" FontWeight="SemiBold"/>
                    <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ModelPredictionsText"
                                   FontSize="10.5" Opacity="0.75" TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

    </Panel>

</UserControl>
