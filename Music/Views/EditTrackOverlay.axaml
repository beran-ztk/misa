<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.EditTrackOverlay"
             Background="Transparent"
             ClipToBounds="True">

    <Panel>
        <Panel.Styles>
            <Style Selector="Border.edit-section">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
            <Style Selector="TextBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            </Style>
            <Style Selector="TextBox.compact-search">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#46FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="4,0,4,1"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
            </Style>
            <Style Selector="TextBox.compact-search:pointerover">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            </Style>
            <Style Selector="TextBox.compact-search:focus">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            </Style>
            <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#46FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style Selector="ComboBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:pointerover">
                <Setter Property="Background" Value="#14FFFFFF"/>
                <Setter Property="BorderBrush" Value="#68FFFFFF"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:checked:pointerover">
                <Setter Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="BorderBrush" Value="#A0FFFFFF"/>
            </Style>
            <Style Selector="Button.edit-choice:pointerover">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
            </Style>
            <Style Selector="Button.rating-star:pointerover">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </Panel.Styles>

        <Border x:Name="EditorSurface"
                Background="#EA1B1914"
                ZIndex="20">

            <Grid RowDefinitions="Auto,1,Auto,1,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="26,15,22,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                        <Image Source="{SvgImage /Assets/info.svg}" Width="18" Height="18" Opacity="0.76"/>
                        <TextBlock Text="Track information" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviewButton"
                                Click="OnPreviewClicked"
                                ToolTip.Tip="Play this track in the main player"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.8">
                            <Image Source="{SvgImage /Assets/play.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="VisibilityButton"
                                Click="OnVisibilityClicked"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.8">
                            <Grid>
                                <Image x:Name="PublicVisibilityIcon" Source="{SvgImage /Assets/eye.svg}" Width="17" Height="17"/>
                                <Image x:Name="PrivateVisibilityIcon" Source="{SvgImage /Assets/eye-slash.svg}" Width="17" Height="17" IsVisible="False"/>
                            </Grid>
                        </Button>
                        <Button x:Name="ReviewButton"
                                Click="OnReviewClicked"
                                ToolTip.Tip="Mark for review"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.45">
                            <Image Source="{SvgImage /Assets/review.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button x:Name="DeleteButton"
                                Click="OnDeleteClicked"
                                ToolTip.Tip="Delete track"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.68">
                            <Image Source="{SvgImage /Assets/trash.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip.Tip="Close"
                                Click="OnCloseClicked"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.65">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#10808080" />

                <Border Grid.Row="2" Height="56" Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto,*" Margin="22,0">
                        <StackPanel x:Name="RatingStarsPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Backdrop focus"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                       Opacity="0.62"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="BackdropFocusSlider"
                                    Classes="playback"
                                    Width="94"
                                    Height="28"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    SmallChange="1"
                                    LargeChange="10"
                                    ValueChanged="OnBackdropFocusChanged"
                                    ToolTip.Tip="Move the visible artwork area left or right" />
                            <Button Content="Center"
                                    Padding="4,0"
                                    FontSize="9.5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnBackdropFocusResetClicked"
                                    ToolTip.Tip="Center artwork" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="3" Fill="#10808080" />

                <ScrollViewer Grid.Row="4"
                              Padding="30,16"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,0,20">

                        <Border Classes="edit-section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Height="28">
                                    <TextBlock Text="Information" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TrackUsageText"
                                               Grid.Column="1"
                                               FontSize="10.5"
                                               Opacity="0.66"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid ColumnDefinitions="104,*,30" RowDefinitions="30,30,30,30" ColumnSpacing="6">
                                    <TextBlock Grid.Row="0" Text="Title" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TitleDisplayText" Grid.Row="0" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" IsVisible="False" Height="28" />
                                    <Button x:Name="EditInformationButton"
                                            Grid.Row="0" Grid.Column="2"
                                            Click="OnEditInformationClicked"
                                            ToolTip.Tip="Edit track information"
                                            Width="28" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Opacity="0.78">
                                        <Image Source="{SvgImage /Assets/pencil-simple.svg}" Width="14" Height="14" />
                                    </Button>

                                    <TextBlock Grid.Row="1" Text="Channel" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelDisplayText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Text="YouTube URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="YouTubeUrlDisplayText" Grid.Row="2" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyYouTubeUrlButton" Grid.Row="2" Grid.Column="2"
                                            Click="OnCopyYouTubeUrlClicked" ToolTip.Tip="Copy YouTube URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>

                                    <TextBlock Grid.Row="3" Text="Channel URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelUrlDisplayText" Grid.Row="3" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyChannelUrlButton" Grid.Row="3" Grid.Column="2"
                                            Click="OnCopyChannelUrlClicked" ToolTip.Tip="Copy channel URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.BorderSubtle}" Margin="0,3" />

                                <Grid x:Name="AudioAnalysisSection" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" Margin="0,5,0,0">
                                    <Border x:Name="BpmMetricCard" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Tempo" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BpmInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="BpmText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="LoudnessMetricCard" Grid.Row="1" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Loudness" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LoudnessInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="IntegratedLoudnessText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DynamicsMetricCard" Grid.Row="2" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Dynamics" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DynamicsInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="LoudnessRangeText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="EmotionalCharacterSection" IsVisible="False" Spacing="6" Margin="0,3,0,0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Cursor="Hand"
                                          PointerPressed="OnEmotionalCharacterHeaderPressed">
                                        <Border Width="14" Height="14" VerticalAlignment="Center">
                                            <Path x:Name="EmotionalCharacterChevron"
                                                  Width="5" Height="9"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4.5 L 0 9"
                                                  Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                                  StrokeThickness="1"
                                                  RenderTransformOrigin="50%,50%">
                                                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Emotional character" FontSize="10.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel x:Name="MirexPrimaryPanel" Spacing="4" Margin="22,0,0,0" />
                                    <TextBlock x:Name="MirexSeeMoreText"
                                               Text="See more"
                                               IsVisible="False"
                                               Margin="22,0,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="10"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.68"
                                               Cursor="Hand"
                                               PointerPressed="OnEmotionalCharacterHeaderPressed" />
                                    <StackPanel x:Name="MirexAdditionalPanel" IsVisible="False" Spacing="5" Margin="22,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="edit-section">
                            <StackPanel Spacing="9">
                            <TextBlock Text="Classification" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Tags" FontSize="11" Opacity="0.68" />
                            <StackPanel x:Name="TagsPanel" Spacing="9" />
                            <StackPanel x:Name="SuggestedTagsSection" Spacing="5" Margin="0,0,0,12" IsVisible="False">
                                <TextBlock Text="Suggested tags" FontSize="11" Opacity="0.68" />
                                <StackPanel x:Name="SuggestedTagsPanel" Spacing="4" />
                            </StackPanel>
                            <StackPanel x:Name="ModelSelectedGenresSection" Spacing="7">
                                <TextBlock Text="Genres" FontSize="11" Opacity="0.68" />
                                <StackPanel x:Name="ModelSelectedGenresPanel" Spacing="6" />
                            </StackPanel>
                            <StackPanel x:Name="DetectedGenresSection" Spacing="6" Margin="0,3,0,5">
                                <Grid x:Name="DetectedGenresHeader"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnDetectedGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="DetectedGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="More model detections"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetectedGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="DetectedGenresPanel"
                                            IsVisible="False"
                                            Spacing="4"
                                            Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel x:Name="FrequentManualGenresSection" Spacing="6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnFrequentManualGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="FrequentManualGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Often added manually"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="FrequentManualGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="FrequentManualGenresPanel"
                                            IsVisible="False"
                                            Spacing="4"
                                            Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel x:Name="AddModelGenreSection" Spacing="6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnAllGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="AllGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="All genres"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AllGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="AllGenresPanel"
                                            IsVisible="False"
                                            Spacing="10"
                                            Margin="17,0,0,3">
                                    <TextBox x:Name="ModelGenreSearchBox"
                                             Classes="compact-search"
                                             Width="280"
                                             MaxWidth="300"
                                             Height="24"
                                             MinHeight="24"
                                             MaxHeight="24"
                                             HorizontalAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             Watermark="Search genres…"
                                             TextChanged="OnModelGenreSearchChanged" />
                                    <Grid ColumnDefinitions="118,13,*">
                                        <StackPanel x:Name="ModelGenreGroupsPanel" />
                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="{DynamicResource Theme.Brush.Divider}"
                                                Margin="6,1" />
                                        <ScrollViewer x:Name="ModelGenreChoicesScroll"
                                                      Grid.Column="2"
                                                      Padding="10,0,0,0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <UniformGrid x:Name="ModelGenreChoicesPanel"
                                                         Columns="2"
                                                         ColumnSpacing="7"
                                                         RowSpacing="7"
                                                         Margin="0,0,0,8" />
                                        </ScrollViewer>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Grid x:Name="StylesSection" ColumnDefinitions="104,*">
                                <TextBlock Text="Styles" FontSize="11" Opacity="0.68" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <WrapPanel x:Name="StylesPanel" Grid.Column="1" Orientation="Horizontal" />
                            </Grid>
                            </StackPanel>
                        </Border>

                        <Border Height="50" />
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="5"
                        IsVisible="False"
                        Background="#C0181A1D">
                    <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#242119" BorderBrush="#71805A" BorderThickness="1" CornerRadius="9" Padding="24,20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Analyzing track…" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="AnalysisElapsedText" Grid.Column="1" Text="0:00" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="5" Foreground="{DynamicResource Theme.Brush.Accent}" Background="#3B392F"/>
                            <TextBlock x:Name="AnalysisEstimateText" FontSize="10.5" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Elapsed time" FontSize="10" Opacity="0.48" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

    </Panel>

</UserControl>
