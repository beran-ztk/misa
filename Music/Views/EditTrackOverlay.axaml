<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.EditTrackOverlay">

    <Panel>

        <Border Background="#17191D"
                ZIndex="20">

            <Grid RowDefinitions="Auto,1,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="26,15,22,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                        <Image Source="{SvgImage /Assets/info.svg}" Width="18" Height="18" Opacity="0.76"/>
                        <TextBlock Text="Track information" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviewButton"
                                Click="OnPreviewClicked"
                                ToolTip.Tip="Play this track in the main player"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.8">
                            <Image Source="{SvgImage /Assets/play.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="SaveBtn"
                                Click="OnSaveClicked"
                                IsEnabled="False"
                                ToolTip.Tip="Save changes"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <Image Source="{SvgImage /Assets/save.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip.Tip="Close"
                                Click="OnCloseClicked"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.65">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#18808080" />

                <ScrollViewer Grid.Row="2"
                              Padding="26,18,26,20"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="22" Margin="0,0,0,20">

                        <StackPanel Spacing="10">
                            <TextBlock Text="Information" FontSize="13" FontWeight="SemiBold" />
                            
                            <Grid ColumnDefinitions="112,*">
                                <TextBlock Text="Title" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <TextBox x:Name="TitleBox" Grid.Column="1" />
                            </Grid>
                            
                            <Grid ColumnDefinitions="112,*">
                                <TextBlock Text="Rating" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <ComboBox x:Name="RatingBox" Grid.Column="1" Width="160" MinHeight="30"
                                          HorizontalAlignment="Left" FontSize="11" />
                            </Grid>
                            
                            <Grid x:Name="ChannelInfoRow" ColumnDefinitions="112,*" Margin="0,4,0,0">
                                <TextBlock Text="Channel" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <TextBox x:Name="ChannelBox" Grid.Column="1" IsReadOnly="True" FontSize="11" />
                            </Grid>
                            <Grid ColumnDefinitions="112,*">
                                <TextBlock Text="YouTube URL" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <TextBox x:Name="YouTubeUrlBox" Grid.Column="1" IsReadOnly="True" FontSize="11" />
                            </Grid>
                            <Grid x:Name="ChannelUrlRow" ColumnDefinitions="112,*">
                                <TextBlock Text="Channel URL" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <TextBox x:Name="ChannelUrlBox" Grid.Column="1" IsReadOnly="True" FontSize="11" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="DetectedGenresSection" Spacing="5" Margin="0,0,40,0">
                            <TextBlock Text="Detected by model · unmapped" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="DetectedGenresPanel" Spacing="3" />
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,0,40,0">
                            <TextBlock Text="Library classification" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="ModelSelectedGenresSection" Spacing="7" Margin="0,0,0,18">
                                <TextBlock Text="Mapped system genres" FontSize="11" Opacity="0.68" />
                                <StackPanel x:Name="ModelSelectedGenresPanel" Spacing="8" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Manual genres" FontSize="11" Opacity="0.68" />
                                <TextBlock x:Name="ManualGenreSummaryText" Grid.Column="1" FontSize="10.5" Opacity="0.5" />
                            </Grid>
                            <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Text="Tags" FontSize="11" Opacity="0.68" />
                                <TextBlock x:Name="TagSummaryText" Grid.Column="1" FontSize="10.5" Opacity="0.5" />
                            </Grid>
                            <StackPanel x:Name="TagsPanel" Spacing="9" />
                            <StackPanel x:Name="SuggestedTagsSection" Spacing="5" Margin="0,8,0,0" IsVisible="False">
                                <TextBlock Text="Suggested tags" FontSize="11" Opacity="0.68" />
                                <StackPanel x:Name="SuggestedTagsPanel" Spacing="4" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="AudioAnalysisSection" Spacing="7" Margin="0,0,40,0">
                            <TextBlock Text="Audio analysis"
                                       FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Spacing="6">
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Tempo" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BpmInsightText" Grid.Column="1" FontSize="10.5" Opacity="0.65" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BpmText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Integrated loudness" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="IntegratedLoudnessInsightText" Grid.Column="1" FontSize="10.5" Opacity="0.65" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="IntegratedLoudnessText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <Border Background="#161C22" BorderBrush="#2D3945" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Loudness range" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LoudnessRangeInsightText" Grid.Column="1" FontSize="10.5" Opacity="0.65" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LoudnessRangeText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SoundProfileSection" Spacing="8" Margin="0,0,40,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Sound profile" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Blue values are model suggestions. Choose a different value only to override one."
                                           FontSize="10.5" Opacity="0.55" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="SoundProfilePanel" Spacing="7" />
                        </StackPanel>

                        <Grid x:Name="StylesSection" ColumnDefinitions="Auto,*" Margin="0,0,40,0">
                            <Border Grid.Column="0"
                                    Width="2" Margin="0,2,0,2"
                                    Background="#40808080" CornerRadius="1" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Styles"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="optional"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="TrackUsageFooter" IsVisible="False"
                                BorderBrush="#26313A" BorderThickness="0,1,0,0"
                                Padding="0,10,0,0" Margin="0,4,40,0">
                            <TextBlock x:Name="TrackUsageText" FontSize="10.5" Opacity="0.58"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border Height="50" />
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="3"
                        IsVisible="False"
                        Background="#C0181A1D">
                    <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#101A27" BorderBrush="#36779F" BorderThickness="1" CornerRadius="9" Padding="24,20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Analyzing track…" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="AnalysisElapsedText" Grid.Column="1" Text="0:00" FontSize="13" FontWeight="SemiBold" Foreground="#65BCEB"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="5" Foreground="#1E9AF0" Background="#26313A"/>
                            <TextBlock x:Name="AnalysisEstimateText" FontSize="10.5" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Elapsed time" FontSize="10" Opacity="0.48" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

    </Panel>

</UserControl>
