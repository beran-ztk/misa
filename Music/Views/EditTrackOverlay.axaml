<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Views.EditTrackOverlay">

    <Panel>
        <Panel.Styles>
            <Style Selector="Border.edit-section">
                <Setter Property="Background" Value="#242119"/>
                <Setter Property="BorderBrush" Value="#4B473B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="12"/>
            </Style>
            <Style Selector="TextBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="#615A49"/>
            </Style>
            <Style Selector="ComboBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="#615A49"/>
            </Style>
        </Panel.Styles>

        <Border Background="#D81B1914"
                ZIndex="20">

            <Grid RowDefinitions="Auto,1,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto,Auto"
                      Margin="26,15,22,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                        <Image Source="{SvgImage /Assets/info.svg}" Width="18" Height="18" Opacity="0.76"/>
                        <TextBlock Text="Track information" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="UnsavedChangesBadge"
                            Grid.Column="1"
                            IsVisible="False"
                            Background="#2C2618"
                            BorderBrush="#8A6C2D"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Unsaved changes"
                                   FontSize="10.5"
                                   Foreground="#FFD98A"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviewButton"
                                Click="OnPreviewClicked"
                                ToolTip.Tip="Play this track in the main player"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.8">
                            <Image Source="{SvgImage /Assets/play.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="SaveBtn"
                                Click="OnSaveClicked"
                                ToolTip.Tip="Save changes"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.85">
                            <Image Source="{SvgImage /Assets/save.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip.Tip="Close"
                                Click="OnCloseClicked"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.65">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#10808080" />

                <ScrollViewer Grid.Row="2"
                              Padding="30,16"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,0,20">

                        <Border Width="188"
                                Height="36"
                                HorizontalAlignment="Center"
                                Background="#211F19"
                                BorderBrush="#615A49"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="0"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="93,93">
                                <Border x:Name="VisibilitySelectionIndicator"
                                        Grid.ColumnSpan="2"
                                        Width="93"
                                        HorizontalAlignment="Left"
                                        Background="#6F7D59"
                                        BorderThickness="0"
                                        CornerRadius="6,0,0,6"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                </Transitions>
                                            </TranslateTransform.Transitions>
                                        </TranslateTransform>
                                    </Border.RenderTransform>
                                </Border>
                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        PointerPressed="OnPublicVisibilityPressed">
                                    <TextBlock x:Name="PublicVisibilityText"
                                               Text="Public"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        PointerPressed="OnPrivateVisibilityPressed">
                                    <TextBlock x:Name="PrivateVisibilityText"
                                               Text="Private"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Classes="edit-section" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,200,1,*" ColumnSpacing="12">
                                <TextBlock Text="Rating" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                <ComboBox x:Name="RatingBox"
                                          Grid.Column="1"
                                          Width="144"
                                          MinHeight="30"
                                          HorizontalAlignment="Left"
                                          FontSize="12"
                                          CornerRadius="5"
                                          Padding="10,3"
                                          BorderThickness="1" />
                                <Rectangle Grid.Column="2" Width="1" Fill="#4B473B" />
                                <TextBlock x:Name="TrackUsageText"
                                           Grid.Column="3"
                                           FontSize="11"
                                           Opacity="0.72"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Classes="edit-section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Information" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="EditInformationButton"
                                            Grid.Column="1"
                                            Click="OnEditInformationClicked"
                                            ToolTip.Tip="Edit track information"
                                            Width="30" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Opacity="0.78">
                                        <Image Source="{SvgImage /Assets/pencil-simple.svg}" Width="15" Height="15" />
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="104,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="6">
                                    <TextBlock Grid.Row="0" Text="Title" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TitleDisplayText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="False" MinHeight="28" />

                                    <TextBlock Grid.Row="1" Text="Channel" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelDisplayText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Text="YouTube URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="YouTubeUrlDisplayText" Grid.Row="2" Grid.Column="1" FontSize="10.5" Foreground="#C7D2AD"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyYouTubeUrlButton" Grid.Row="2" Grid.Column="2"
                                            Click="OnCopyYouTubeUrlClicked" ToolTip.Tip="Copy YouTube URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>

                                    <TextBlock Grid.Row="3" Text="Channel URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelUrlDisplayText" Grid.Row="3" Grid.Column="1" FontSize="10.5" Foreground="#C7D2AD"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyChannelUrlButton" Grid.Row="3" Grid.Column="2"
                                            Click="OnCopyChannelUrlClicked" ToolTip.Tip="Copy channel URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="edit-section">
                            <StackPanel Spacing="9">
                            <TextBlock Text="Classification" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tags" FontSize="11" Opacity="0.68" />
                                <TextBlock x:Name="TagSummaryText" Grid.Column="1" FontSize="10.5" Opacity="0.5" />
                            </Grid>
                            <StackPanel x:Name="TagsPanel" Spacing="9" />
                            <StackPanel x:Name="SuggestedTagsSection" Spacing="5" Margin="0,0,0,12" IsVisible="False">
                                <TextBlock Text="Suggested tags" FontSize="11" Opacity="0.68" />
                                <StackPanel x:Name="SuggestedTagsPanel" Spacing="4" />
                            </StackPanel>
                            <StackPanel x:Name="ModelSelectedGenresSection" Spacing="7">
                                <TextBlock Text="Active genres" FontSize="11" Opacity="0.68" />
                                <WrapPanel x:Name="ModelSelectedGenresPanel" Orientation="Horizontal" />
                            </StackPanel>
                            <StackPanel x:Name="DetectedGenresSection" Spacing="5" Margin="0,2,0,4">
                                <TextBlock Text="More model detections" FontSize="11" Opacity="0.68" />
                                <UniformGrid x:Name="DetectedGenresPanel" Columns="2" />
                            </StackPanel>
                            <StackPanel x:Name="AddModelGenreSection" Margin="0,2,0,4">
                                <Border Background="#211F19"
                                        BorderBrush="#4B473B"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock Text="Add genre"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="ModelGenreChoiceSummaryText"
                                                       Grid.Column="1"
                                                       FontSize="10.5"
                                                       Opacity="0.48"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <ComboBox x:Name="ModelGenreCategoryFilterBox"
                                                      Grid.Column="0"
                                                      Height="30"
                                                      FontSize="11"
                                                      SelectionChanged="OnModelGenreFilterChanged"/>
                                            <TextBox x:Name="ModelGenreSearchBox"
                                                     Grid.Column="1"
                                                     Height="30"
                                                     FontSize="11"
                                                     Watermark="Search subgenre…"
                                                     TextChanged="OnModelGenreSearchChanged"/>
                                        </Grid>
                                        <StackPanel x:Name="FrequentManualGenresSection" Spacing="5">
                                            <TextBlock Text="Often added manually"
                                                       FontSize="10.5"
                                                       Opacity="0.55"/>
                                            <UniformGrid x:Name="FrequentManualGenresPanel" Columns="4" />
                                        </StackPanel>
                                        <ScrollViewer MaxHeight="246"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <UniformGrid x:Name="ModelGenreChoicesPanel" Columns="3" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid x:Name="StylesSection" ColumnDefinitions="104,*">
                                <TextBlock Text="Styles" FontSize="11" Opacity="0.68" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <WrapPanel x:Name="StylesPanel" Grid.Column="1" Orientation="Horizontal" />
                            </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AnalysisCharacterSection" Classes="edit-section">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Audio &amp; character" FontSize="13" FontWeight="SemiBold" />

                                <Grid x:Name="AudioAnalysisSection" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border x:Name="BpmMetricCard" Grid.Column="0" Background="#2A271F" CornerRadius="5" Padding="10,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Tempo" FontSize="10.5" Opacity="0.62" />
                                            <TextBlock x:Name="BpmText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="LoudnessMetricCard" Grid.Column="1" Background="#2A271F" CornerRadius="5" Padding="10,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Loudness" FontSize="10.5" Opacity="0.62" />
                                            <TextBlock x:Name="IntegratedLoudnessText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DynamicsMetricCard" Grid.Column="2" Background="#2A271F" CornerRadius="5" Padding="10,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Dynamics" FontSize="10.5" Opacity="0.62" />
                                            <TextBlock x:Name="LoudnessRangeText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="SoundProfileSection" Spacing="7">
                                    <TextBlock Text="Sound profile" FontSize="11" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                        <StackPanel x:Name="SoundProfileLeftPanel" Grid.Column="0" Spacing="6" />
                                        <StackPanel x:Name="SoundProfileRightPanel" Grid.Column="1" Spacing="6" />
                                    </Grid>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#4B473B" />

                                <StackPanel Spacing="5" Margin="0,2,0,2">
                                    <TextBlock Text="Emotional character" FontSize="10.5" FontWeight="SemiBold" />
                                    <StackPanel x:Name="MirexCharacterPanel" Spacing="3" />
                                </StackPanel>

                                <Rectangle Height="1" Fill="#4B473B" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Mood signals" FontSize="10.5" FontWeight="SemiBold" />
                                    <StackPanel x:Name="MoodSignalsPanel" Spacing="5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="50" />
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="3"
                        IsVisible="False"
                        Background="#C0181A1D">
                    <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#242119" BorderBrush="#71805A" BorderThickness="1" CornerRadius="9" Padding="24,20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Analyzing track…" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="AnalysisElapsedText" Grid.Column="1" Text="0:00" FontSize="13" FontWeight="SemiBold" Foreground="#C7D2AD"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="5" Foreground="#AFC58C" Background="#3B392F"/>
                            <TextBlock x:Name="AnalysisEstimateText" FontSize="10.5" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Elapsed time" FontSize="10" Opacity="0.48" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

                <Border x:Name="UnsavedChangesLayer"
                        Grid.RowSpan="3"
                        IsVisible="False"
                        Background="#CC1B1914">
                    <Border Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#242119"
                            BorderBrush="#615A49"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="22,18">
                        <StackPanel Spacing="13">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Unsaved changes"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Save your changes before closing this track?"
                                           FontSize="11"
                                           Opacity="0.66"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="Keep editing"
                                        Padding="10,5"
                                        Click="OnKeepEditingClicked"/>
                                <Button Content="Discard"
                                        Padding="10,5"
                                        Click="OnDiscardChangesClicked"/>
                                <Button Content="Save"
                                        Classes="accent"
                                        Padding="12,5"
                                        Click="OnSaveAndCloseClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

    </Panel>

</UserControl>
