<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.ChannelOverlay">
    <UserControl.Styles>
        <Style Selector="ListBox.channel-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.channel-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#352F24"/>
        </Style>
        <Style Selector="ListBox.channel-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4638"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.channel-icon">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.channel-icon:pointerover">
            <Setter Property="Background" Value="#39352B"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#E81B1914" BorderBrush="#554F41" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*" Margin="22,18,22,22">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,14">
                <Button Classes="channel-icon" Click="OnSidebarToggleClicked" ToolTip.Tip="Channels">
                    <TextBlock Text="☰" FontSize="17"/>
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="SelectedChannelText" Text="Channels" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.62"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Border Background="#A82A261D" BorderBrush="#4B473B" BorderThickness="1" CornerRadius="8" Padding="10">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="4,0,4,10">
                            <TextBlock x:Name="VideoSummaryText" FontSize="11" Opacity="0.62"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Max duration" FontSize="10.5" Opacity="0.68" VerticalAlignment="Center"/>
                                <TextBox x:Name="GlobalMaxDurationBox" Width="44" Height="28" Padding="5,2" FontSize="10.5"
                                         LostFocus="OnGlobalMaxDurationLostFocus"/>
                                <TextBlock Text="min" FontSize="10.5" Opacity="0.68" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="146" Height="30" Background="#211F19" BorderBrush="#615A49"
                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid ColumnDefinitions="72,72">
                                    <Border x:Name="VideoFilterSelectionIndicator" Grid.ColumnSpan="2" Width="72"
                                            HorizontalAlignment="Left" Background="#6F7D59" CornerRadius="5" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform>
                                                <TranslateTransform.Transitions>
                                                    <Transitions><DoubleTransition Property="X" Duration="0:0:0.16"/></Transitions>
                                                </TranslateTransform.Transitions>
                                            </TranslateTransform>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand" PointerPressed="OnPendingFilterPressed">
                                        <TextBlock x:Name="PendingFilterText" Text="Pending" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="Transparent" Cursor="Hand" PointerPressed="OnAllFilterPressed">
                                        <TextBlock x:Name="AllFilterText" Text="All" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Grid.Column="3" Classes="channel-icon" Click="OnRefreshSelectedClicked"
                                    ToolTip.Tip="Refresh selected channel" Opacity="0.68">
                                <Image Source="{SvgImage /Assets/reload.svg}" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <ListBox x:Name="VideoList" Classes="video-list" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="views:ChannelVideoDisplay">
                                    <Border Background="{Binding Background}" Opacity="{Binding Opacity}" CornerRadius="6" Padding="8,6" Margin="0,1">
                                        <Grid ColumnDefinitions="*,110,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextDecorations="{Binding TextDecorations}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DownloadErrorSummary}" IsVisible="{Binding HasDownloadError}"
                                                           ToolTip.Tip="{Binding DownloadErrorDetails}" FontSize="10.5"
                                                           Foreground="#E87878" Opacity="0.86" TextWrapping="Wrap" MaxHeight="34"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5" Opacity="0.62"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Classes="channel-icon" Click="OnVideoPlayClicked" IsEnabled="{Binding CanPlay}"
                                                    ToolTip.Tip="Play downloaded audio" Opacity="{Binding ActionOpacity}">
                                                <Image Source="{SvgImage /Assets/play.svg}" Width="14" Height="14"/>
                                            </Button>
                                            <Button Grid.Column="3" Classes="channel-icon" Click="OnVideoCheckClicked" IsEnabled="{Binding CanReview}"
                                                    ToolTip.Tip="Accept and queue analysis" Opacity="{Binding ActionOpacity}">
                                                <Image Source="{SvgImage /Assets/check.svg}" Width="15" Height="15"/>
                                            </Button>
                                            <Button Grid.Column="4" Classes="channel-icon" Click="OnVideoSkipClicked" IsEnabled="{Binding CanReview}"
                                                    ToolTip.Tip="Skip (keep audio)" Opacity="{Binding ActionOpacity}">
                                                <Image Source="{SvgImage /Assets/close.svg}" Width="14" Height="14"/>
                                            </Button>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                                <Button Classes="channel-icon" Click="OnCopyVideoUrlClicked" ToolTip.Tip="Copy video URL" Opacity="0.65">
                                                    <Image Source="{SvgImage /Assets/copy.svg}" Width="14" Height="14"/>
                                                </Button>
                                                <TextBlock Text="{Binding DurationText}" FontSize="10.5" Opacity="0.62"
                                                           MinWidth="38" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border x:Name="ChannelSidebar" Width="310" HorizontalAlignment="Left" IsVisible="False"
                        Background="#FA211F19" BorderBrush="#5B5546" BorderThickness="1" CornerRadius="8" Padding="12"
                        BoxShadow="4 0 18 0 #90000000">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Manage channels" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="channel-icon" Click="OnSidebarToggleClicked" ToolTip.Tip="Close sidebar">
                                <Image Source="{SvgImage /Assets/close.svg}" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="UrlBox" Watermark="Paste YouTube channel URL" Height="36"
                                 TextChanged="OnUrlTextChanged" VerticalContentAlignment="Center"/>
                        <ListBox Grid.Row="2" x:Name="ChannelList" Classes="channel-list" SelectionChanged="OnChannelSelectionChanged"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChannelSubscription">
                                    <Grid RowDefinitions="Auto,1">
                                        <Border Padding="9,8" CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" FontSize="10.5" Opacity="0.58"
                                                           Text="{Binding UncheckedCount, StringFormat='{}{0} pending'}"/>
                                                <TextBlock Grid.Row="2" FontSize="10.5" Opacity="0.72" Margin="0,2,0,0"
                                                           Text="{Binding DownloadStateText}" TextWrapping="Wrap"/>
                                                <CheckBox Grid.Row="3" Content="Auto-download" IsChecked="{Binding AutoDownload, Mode=OneWay}"
                                                          Click="OnAutoDownloadClicked" FontSize="10.5" Margin="0,5,0,0"/>
                                                <Button Grid.Column="1" Grid.RowSpan="4" Classes="channel-icon" Click="OnDeleteChannelClicked"
                                                        ToolTip.Tip="Delete channel" Opacity="0.58" VerticalAlignment="Center">
                                                    <Image Source="{SvgImage /Assets/trash.svg}" Width="15" Height="15"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Row="1" Height="1" Fill="#4B473B" Margin="8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
