<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.ChannelOverlay">
    <Border Background="#EA0B0D10"
            BorderBrush="#25313D"
            BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*" Margin="30,22,30,26">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                <StackPanel Spacing="3">
                    <TextBlock Text="Channels" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Text="Track YouTube channels and mark videos as checked."
                               FontSize="11"
                               Opacity="0.62"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Click="OnCloseClicked"
                        Background="Transparent"
                        BorderBrush="#314B5F"
                        BorderThickness="1"
                        Padding="12,6"
                        FontSize="11"
                        Opacity="0.78"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox x:Name="UrlBox"
                             Watermark="YouTube channel URL"
                             Height="36"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Add"
                            Click="OnAddClicked"
                            Background="#12334A"
                            BorderBrush="#2D6E96"
                            BorderThickness="1"
                            Padding="16,7"
                            FontSize="11"/>
                    <Button Grid.Column="2"
                            Content="Refresh"
                            Click="OnRefreshClicked"
                            Background="Transparent"
                            BorderBrush="#314B5F"
                            BorderThickness="1"
                            Padding="16,7"
                            FontSize="11"
                            Opacity="0.78"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="18">
                    <Border Background="#A80B0D10"
                            BorderBrush="#263442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <ListBox x:Name="ChannelList"
                                 SelectionChanged="OnChannelSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChannelSubscription">
                                    <Border Padding="10,8" CornerRadius="6">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1"
                                                       FontSize="10.5"
                                                       Opacity="0.58"
                                                       Text="{Binding UncheckedCount, StringFormat='{}{0} unchecked'}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#A80B0D10"
                            BorderBrush="#263442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                                <TextBlock x:Name="VideoSummaryText"
                                           FontSize="11"
                                           Opacity="0.62"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Refresh selected"
                                        Click="OnRefreshSelectedClicked"
                                        Background="Transparent"
                                        BorderBrush="#314B5F"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        FontSize="11"
                                        Opacity="0.74"/>
                            </Grid>
                            <ListBox x:Name="VideoList"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="views:ChannelVideoDisplay">
                                        <Border Background="{Binding Background}"
                                                Opacity="{Binding Opacity}"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,1">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          Checked="OnVideoCheckedChanged"
                                                          Unchecked="OnVideoCheckedChanged"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           TextDecorations="{Binding TextDecorations}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DurationText}"
                                                           FontSize="10.5"
                                                           Opacity="0.62"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Content="Copy URL"
                                                        Click="OnCopyVideoUrlClicked"
                                                        Background="Transparent"
                                                        BorderBrush="#314B5F"
                                                        BorderThickness="1"
                                                        Padding="8,4"
                                                        FontSize="10.5"
                                                        Opacity="0.78"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
