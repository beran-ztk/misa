<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.ChannelOverlay">
    <UserControl.Styles>
        <Style Selector="ListBox.channel-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.channel-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#182A37"/>
        </Style>
        <Style Selector="ListBox.channel-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F4258"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.channel-icon">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.channel-icon:pointerover">
            <Setter Property="Background" Value="#24313B"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#EA0B0D10"
            BorderBrush="#25313D"
            BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*" Margin="30,22,30,26">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                <StackPanel Spacing="3">
                    <TextBlock Text="Channels" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Text="Track YouTube channels and mark videos as checked."
                               FontSize="11"
                               Opacity="0.62"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="channel-icon"
                        Click="OnCloseClicked"
                        ToolTip.Tip="Close"
                        Opacity="0.72">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16">
                <TextBox x:Name="UrlBox"
                         Watermark="Paste YouTube channel URL"
                         Height="36"
                         TextChanged="OnUrlTextChanged"
                         VerticalContentAlignment="Center"/>

                <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="18">
                    <Border Background="#A80B0D10"
                            BorderBrush="#263442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <ListBox x:Name="ChannelList"
                                 Classes="channel-list"
                                 SelectionChanged="OnChannelSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChannelSubscription">
                                    <Grid RowDefinitions="Auto,1">
                                        <Border Grid.Row="0" Padding="10,8" CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1"
                                                           FontSize="10.5"
                                                           Opacity="0.58"
                                                           Text="{Binding UncheckedCount, StringFormat='{}{0} pending'}"/>
                                                <Button Grid.Column="1"
                                                        Grid.RowSpan="2"
                                                        Classes="channel-icon"
                                                        Click="OnDeleteChannelClicked"
                                                        ToolTip.Tip="Delete channel"
                                                        Opacity="0.58"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{SvgImage /Assets/trash.svg}" Width="15" Height="15"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Row="1" Height="1" Fill="#263442" Margin="8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#A80B0D10"
                            BorderBrush="#263442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="4,0,4,10">
                                <TextBlock x:Name="VideoSummaryText"
                                           FontSize="11"
                                           Opacity="0.62"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Width="146"
                                        Height="30"
                                        Background="#111A21"
                                        BorderBrush="#435868"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid ColumnDefinitions="72,72">
                                        <Border x:Name="VideoFilterSelectionIndicator"
                                                Grid.ColumnSpan="2"
                                                Width="72"
                                                HorizontalAlignment="Left"
                                                Background="#176486"
                                                CornerRadius="5"
                                                IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                        </Transitions>
                                                    </TranslateTransform.Transitions>
                                                </TranslateTransform>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                PointerPressed="OnPendingFilterPressed">
                                            <TextBlock x:Name="PendingFilterText" Text="Pending" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                PointerPressed="OnAllFilterPressed">
                                            <TextBlock x:Name="AllFilterText" Text="All" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="2"
                                        Classes="channel-icon"
                                        Click="OnRefreshSelectedClicked"
                                        ToolTip.Tip="Refresh selected channel"
                                        HorizontalAlignment="Right"
                                        Opacity="0.68">
                                    <Image Source="{SvgImage /Assets/reload.svg}" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                            <ListBox x:Name="VideoList"
                                     Classes="video-list"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="views:ChannelVideoDisplay">
                                        <Border Background="{Binding Background}"
                                                Opacity="{Binding Opacity}"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,1">
                                            <Grid ColumnDefinitions="*,Auto,Auto,58" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           TextDecorations="{Binding TextDecorations}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Classes="channel-icon"
                                                        Click="OnVideoCheckClicked"
                                                        ToolTip.Tip="Mark as handled"
                                                        Background="{Binding CheckBackground}"
                                                        BorderBrush="{Binding CheckBorder}"
                                                        BorderThickness="1"
                                                        Opacity="{Binding CheckOpacity}">
                                                    <Image Source="{SvgImage /Assets/check.svg}" Width="15" Height="15"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Classes="channel-icon"
                                                        Click="OnCopyVideoUrlClicked"
                                                        ToolTip.Tip="Copy video URL"
                                                        Opacity="0.72">
                                                    <Image Source="{SvgImage /Assets/copy.svg}" Width="15" Height="15"/>
                                                </Button>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DurationText}"
                                                           FontSize="10.5"
                                                           Opacity="0.62"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
