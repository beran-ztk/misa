<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.MusicView">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2430"/>
            <Setter Property="BorderBrush" Value="#516174"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Background" Value="#0B0D10"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Foreground" Value="#1E9AF0"/>
            <Setter Property="Background" Value="#33404A"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#26313A"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#22262C"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#183A57"/>
        </Style>
    </UserControl.Styles>

    <Panel Background="#121417">
    <Image x:Name="AppArtworkBackground"
           IsVisible="False"
           IsHitTestVisible="False"
           Opacity="0.12"
           Stretch="UniformToFill"
           RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
        </Image.RenderTransform>
        <Image.Effect>
            <BlurEffect Radius="22"/>
        </Image.Effect>
    </Image>
    <Rectangle Fill="#D9121417" IsHitTestVisible="False"/>
    <Rectangle Fill="#4A000000" IsHitTestVisible="False"/>
    <DockPanel LastChildFill="True">

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="#CC07080A"
                BorderBrush="#16212C"
                BorderThickness="0,0,0,1"
                Padding="20,12,16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaylistSummaryText"
                               Text=""
                               FontSize="11"
                               Opacity="0.55"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="QueueStatusText"
                               IsVisible="False"
                               FontSize="11"
                               Foreground="#78C7EE"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">

                <Button Click="OnImportClicked"
                        ToolTip.Tip="Add Track"
                        Width="34" Height="34"
                        BorderThickness="1"
                        Background="#10151B"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <Image Source="{SvgImage /Assets/download.svg}" Width="17" Height="17"/>
                </Button>

                <TextBox x:Name="SearchBox"
                         Watermark="Search…"
                         Width="230" Height="34"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="ReviewFilterBtn"
                        Classes="icon"
                        Click="OnReviewFilterClicked"
                        Background="#10151B"
                        BorderThickness="1"
                        Opacity="0.35"
                        ToolTip.Tip="Show review marks">
                    <Image Source="{SvgImage /Assets/review.svg}"
                           Width="17" Height="17"/>
                </Button>

                <Button x:Name="ExportBtn"
                        Classes="icon"
                        Click="OnExportClicked"
                        Background="#10151B"
                        BorderThickness="1"
                        ToolTip.Tip="Export Android library"
                        VerticalContentAlignment="Center">
                    <Image Source="{SvgImage /Assets/export.svg}"
                           Width="17" Height="17"/>
                </Button>

                <Button Classes="icon"
                        Click="OnSettingsClicked"
                        Background="#10151B"
                        BorderThickness="1"
                        ToolTip.Tip="Settings">
                    <Image Source="{SvgImage /Assets/gear.svg}"
                           Width="17" Height="17"/>
                </Button>

                <Button x:Name="FiltersToggleBtn"
                        Classes="icon"
                        Click="OnToggleFiltersClicked"
                        Background="#10151B"
                        BorderThickness="1"
                        ToolTip.Tip="Open filter panel"
                        VerticalContentAlignment="Center">
                    <Image Source="{SvgImage /Assets/filter.svg}"
                           Width="17" Height="17"/>
                </Button>

            </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status / error text (hidden until needed) ── -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="" TextWrapping="Wrap"
                   IsVisible="False"
                   Height="0"/>

        <!-- ── Player bar ── -->
        <Border x:Name="PlayerBar"
                DockPanel.Dock="Bottom"
                Padding="0"
                MaxHeight="132"
                Background="#CC07080A"
                ClipToBounds="True"
                BorderThickness="0,1,0,0" BorderBrush="#202832">
            <Panel>
                <Image x:Name="PlayerArtworkBackground"
                       IsVisible="False"
                       IsHitTestVisible="False"
                       Height="132"
                       VerticalAlignment="Stretch"
                       Opacity="0.26"
                       Stretch="UniformToFill"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <BlurEffect Radius="14"/>
                    </Image.Effect>
                </Image>
                <Rectangle Fill="#E607080A" IsHitTestVisible="False"/>
                <Rectangle Fill="#30000000" IsHitTestVisible="False"/>
                <StackPanel Margin="16,10,16,14">

                <Border x:Name="UpcomingBar"
                        IsVisible="False"
                        Padding="4,0,4,0">
                    <DockPanel>
                        <TextBlock x:Name="CrossfadeStatusText"
                                   DockPanel.Dock="Right"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Next:"
                                       FontSize="11" Opacity="0.4"/>
                            <TextBlock x:Name="UpcomingTrackText"
                                       FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="PlaybackInfoPanel"
                      ColumnDefinitions="*,Auto"
                      IsVisible="False">
                    <Border Grid.Column="0"
                            ClipToBounds="False">
                        <Slider x:Name="PlaybackSlider"
                                Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PlaybackTimeText"
                               Grid.Column="1"
                               Text="" FontSize="11" Opacity="0.55"
                               Margin="10,0,0,0" MinWidth="86"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="icon"
                                Click="OnPreviousClicked"
                                ToolTip.Tip="Previous track">
                            <Image Source="{SvgImage /Assets/skip-back.svg}"
                                   Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="PlayPauseBtn"
                                Classes="icon"
                                Click="OnPlayPauseClicked"
                                ToolTip.Tip="Play / Pause">
                            <Grid Width="26" Height="26">
                                <Image x:Name="PlayIcon"
                                       Source="{SvgImage /Assets/play.svg}"/>
                                <Image x:Name="PauseIcon"
                                       Source="{SvgImage /Assets/pause.svg}"
                                       IsVisible="False"/>
                            </Grid>
                        </Button>
                        <Button Classes="icon"
                                Click="OnNextClicked"
                                ToolTip.Tip="Next track">
                            <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                   Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               x:Name="NowPlayingText"
                               Text=""
                               FontStyle="Italic" Opacity="0.7"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <Border ClipToBounds="False">
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0" Maximum="100" 
                                    Value="100"
                                    Width="108"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="ShuffleBtn"
                                Classes="icon"
                                Click="OnShuffleToggleClicked"
                                Opacity="0.35"
                                ToolTip.Tip="Shuffle: Off">
                            <Image Source="{SvgImage /Assets/shuffle.svg}"
                                   Width="17" Height="17"/>
                        </Button>
                        <Button x:Name="ReviewBtn"
                                Classes="icon"
                                Click="OnReviewToggleClicked"
                                Opacity="0.35"
                                ToolTip.Tip="Mark for review">
                            <Image Source="{SvgImage /Assets/review.svg}"
                                   Width="17" Height="17"/>
                        </Button>
                    </StackPanel>

                </Grid>
                </StackPanel>
            </Panel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             Track list + filter drawer overlay (Panel fills remaining space)
             ══════════════════════════════════════════════════════ -->
        <Panel>
            <Image x:Name="ListArtworkBackground"
                   IsVisible="False"
                   IsHitTestVisible="False"
                   Opacity="0.2"
                   Stretch="UniformToFill"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="18"/>
                </Image.Effect>
            </Image>
            <Rectangle Fill="#9A07080A" IsHitTestVisible="False"/>
            <Rectangle Fill="#26000000" IsHitTestVisible="False"/>

            <ListBox x:Name="FileList"
                     DoubleTapped="OnListDoubleTapped"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4,4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackDisplayItem">
                        <Border Background="{Binding PlayingBackground}"
                                CornerRadius="7"
                                Padding="4,4">
                            <Grid ColumnDefinitions="4,52,*">

                                <Border Grid.Column="0"
                                        Width="3" Height="38"
                                        CornerRadius="2"
                                        Background="{Binding PlayingAccent}"
                                        VerticalAlignment="Center"/>

                                <!-- Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="40" Height="40"
                                        CornerRadius="6" ClipToBounds="True"
                                        Margin="8,0,12,0" VerticalAlignment="Center"
                                        Background="#262B32">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- Compact metadata: identity, classification, then profile -->
                                <Grid Grid.Column="2"
                                      VerticalAlignment="Center"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="2">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                        <Border Background="{Binding RatingBackground}"
                                                BorderBrush="{Binding RatingBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Height="18"
                                                Padding="5,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RatingText}"
                                                       FontSize="9.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="#DCE6EF"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="  ·  " FontSize="10.5" Opacity="0.42" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ChannelText}"
                                                   FontSize="10.5" Opacity="0.52"
                                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ChannelSeparatorText}"
                                                   FontSize="10.5" Opacity="0.42" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Track.Title}"
                                               Foreground="{Binding TitleBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ModelGenreText}"
                                                       FontSize="11" Foreground="#65BCEB"
                                                       MaxWidth="520"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GenreSeparatorText}"
                                                       FontSize="11"
                                                       Opacity="0.42"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ManualGenreText}"
                                                       FontSize="11"
                                                       Foreground="#A9BAC8"
                                                       Opacity="0.78"
                                                       MaxWidth="360"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                                   FontSize="10.5" Opacity="0.56"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProfileText}"
                                                   FontSize="10.5" Foreground="#A9BAC8" Opacity="0.62"
                                                   MaxWidth="360"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <views:TrackTagSummaryControl Tags="{Binding TagDisplays}"
                                                                      Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="OnContextEditClicked"/>
                        <MenuItem Header="Toggle review mark" Click="OnContextToggleReviewClicked"/>
                        <Separator/>
                        <MenuItem Header="Delete track (including file)" Click="OnContextDeleteClicked"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- ── Filter drawer (right-side overlay) ── -->
            <Border x:Name="FilterDrawer"
                    Width="310" HorizontalAlignment="Right"
                    IsVisible="False"
                    Background="#101216"
                    BorderThickness="1,0,0,0" BorderBrush="#2B3642"
                    BoxShadow="-10 0 34 0 #77000000">
                <DockPanel LastChildFill="True">

                    <!-- Header (docked top) -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
                          Margin="16,13,10,13">
                        <TextBlock Grid.Column="0"
                                   Text="Filters"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Click="OnClearFiltersClicked"
                                Padding="8,4" FontSize="11"
                                Opacity="0.6"
                                Background="Transparent"/>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top"
                               Height="1" Fill="#18808080"/>

                    <!-- Footer (docked bottom, always visible) -->
                    <Border DockPanel.Dock="Bottom"
                            BorderThickness="0,1,0,0" BorderBrush="#14808080"
                            Padding="16,10,16,12">
                        <Button Content="＋ Add group"
                                Click="OnAddFilterGroupClicked"
                                Background="#0D151D"
                                BorderBrush="#314B5F"
                                BorderThickness="1"
                                Padding="10,6" FontSize="11"
                                HorizontalAlignment="Left"/>
                    </Border>

                    <!-- Scrollable filter sections (fills remaining space) -->
                    <ScrollViewer Padding="16,14,16,10">
                        <StackPanel Spacing="20">

                            <!-- Presets -->
                            <StackPanel Spacing="7">
                                <TextBlock Text="PRESETS"
                                           FontSize="10" FontWeight="SemiBold"
                                           Opacity="0.38" LetterSpacing="1"/>
                                <ComboBox x:Name="PresetBox"
                                          SelectionChanged="OnPresetSelectionChanged"
                                          HorizontalAlignment="Stretch"
                                          Height="34"
                                          Background="#0D151D"
                                          BorderBrush="#414B5F"
                                          BorderThickness="1"
                                          CornerRadius="6"
                                          Padding="8,4"/>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="7">
                                    <TextBox x:Name="PresetNameBox"
                                             Watermark="Preset name"
                                             Height="32"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Save"
                                            Click="OnSavePresetClicked"
                                            Background="#0D151D"
                                            BorderBrush="#314B5F"
                                            BorderThickness="1"
                                            Padding="10,5"
                                            FontSize="11"/>
                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Click="OnDeletePresetClicked"
                                            Background="Transparent"
                                            BorderBrush="#314B5F"
                                            BorderThickness="1"
                                            Padding="10,5"
                                            FontSize="11"
                                            Opacity="0.75"/>
                                </Grid>
                            </StackPanel>

                            <!-- Rating -->
                            <StackPanel Spacing="7">
                                <TextBlock Text="RATING"
                                           FontSize="10" FontWeight="SemiBold"
                                           Opacity="0.38" LetterSpacing="1"/>
                                <views:MultiSelectFilterControl x:Name="RatingFilter"
                                                                Placeholder="---"/>
                            </StackPanel>

                            <!-- Tags -->
                            <StackPanel Spacing="0">
                                <TextBlock Text="TAGS"
                                           FontSize="10" FontWeight="SemiBold"
                                           Opacity="0.38" LetterSpacing="1"
                                           Margin="0,0,0,10"/>
                                <StackPanel x:Name="FilterGroupsPanel" Spacing="0"/>
                            </StackPanel>
                            <Border Height="30"/>
                        </StackPanel>
                        
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <views:AddTrackOverlay x:Name="AddTrackOverlay" IsVisible="False"/>

        </Panel>

    </DockPanel>

    <!-- Queue management is a workspace, not a small dialog. It deliberately stops above the player. -->
    <views:ImportOverlay x:Name="ImportOverlay" IsVisible="False" ZIndex="70"/>

    <!-- Covers the toolbar as well as the list while track details are open. -->
    <views:EditTrackOverlay x:Name="EditTrackOverlay" IsVisible="False" ZIndex="80"/>

    <views:SettingsOverlay x:Name="SettingsOverlay" IsVisible="False" ZIndex="90"/>

    <Border x:Name="Toast"
            IsVisible="False"
            ZIndex="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,104,0,0"
            Background="#E6101821"
            BorderBrush="#314B5F"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,9"
            BoxShadow="0 8 24 2 #66000000">
        <TextBlock x:Name="ToastText"
                   FontSize="12"
                   Foreground="#EAF3FA"/>
    </Border>

    </Panel>

</UserControl>
