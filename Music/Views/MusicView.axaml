<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.MusicView">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2430"/>
            <Setter Property="BorderBrush" Value="#516174"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Background" Value="#0B0D10"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Foreground" Value="#1E9AF0"/>
            <Setter Property="Background" Value="#33404A"/>
        </Style>
        <Style Selector="Slider.playback">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="#38A8F2"/>
            <Setter Property="Background" Value="#263542"/>
        </Style>
        <Style Selector="Slider.playback /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="#E6F7FF"/>
            <Setter Property="BorderBrush" Value="#38A8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Slider.playback:pointerover /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#26313A"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.track-card">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.track-card:pointerover">
            <Setter Property="Background" Value="#3022262C"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Image x:Name="AppArtworkBackground"
           IsVisible="False"
           IsHitTestVisible="False"
           Opacity="0.12"
           Stretch="UniformToFill"
           RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
        </Image.RenderTransform>
        <Image.Effect>
            <BlurEffect Radius="20"/>
        </Image.Effect>
    </Image>
    <Rectangle x:Name="AppAtmosphereTint"
               Fill="#00000000"
               IsHitTestVisible="False"/>
    <Rectangle Fill="#A0121417" IsHitTestVisible="False"/>
    <DockPanel LastChildFill="True">

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="#2A07080A"
                BorderBrush="#16212C"
                BorderThickness="0,0,0,1"
                Padding="20,12,16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaylistSummaryText"
                               Text=""
                               FontSize="11"
                               Opacity="0.55"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="QueueStatusText"
                               IsVisible="False"
                               FontSize="11"
                               Foreground="#78C7EE"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LibraryDirtyText"
                               Text="Library changed"
                               IsVisible="False"
                               FontSize="11"
                               Foreground="#E6BF55"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">

                <Button Click="OnImportClicked"
                        Classes="icon"
                        ToolTip.Tip="Add Track"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/download.svg}" Width="17" Height="17"/>
                </Button>

                <Button Click="OnChannelsClicked"
                        Classes="icon"
                        ToolTip.Tip="Channels"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/info.svg}" Width="17" Height="17"/>
                </Button>

                <Button x:Name="RefreshLibraryButton"
                        Click="OnRefreshLibraryClicked"
                        Classes="icon"
                        ToolTip.Tip="Refresh library"
                        IsVisible="False"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/reload.svg}" Width="17" Height="17"/>
                </Button>

                <TextBox x:Name="SearchBox"
                         Watermark="Search…"
                         IsVisible="False"
                         Width="230" Height="34"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown"
                         LostFocus="OnSearchBoxLostFocus"/>

                <Button x:Name="SearchToggleBtn"
                        Classes="icon"
                        Click="OnSearchToggleClicked"
                        ToolTip.Tip="Search"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                </Button>

                <Button x:Name="ReviewFilterBtn"
                        Classes="icon"
                        Click="OnReviewFilterClicked"
                        Opacity="0.35"
                        ToolTip.Tip="Show review marks">
                    <Image Source="{SvgImage /Assets/review.svg}"
                           Width="17" Height="17"/>
                </Button>

                <Button Classes="icon"
                        Click="OnSettingsClicked"
                        Opacity="0.86"
                        ToolTip.Tip="Settings">
                    <Image Source="{SvgImage /Assets/gear.svg}"
                           Width="17" Height="17"/>
                </Button>

                <Button x:Name="FiltersToggleBtn"
                        Classes="icon"
                        Click="OnToggleFiltersClicked"
                        ToolTip.Tip="Open filters"
                        VerticalContentAlignment="Center"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/filter.svg}"
                           Width="17" Height="17"/>
                </Button>

            </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status / error text (hidden until needed) ── -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="" TextWrapping="Wrap"
                   IsVisible="False"
                   Height="0"/>

        <!-- Library and player occupy separate rows over one continuous artwork background. -->
        <Grid RowDefinitions="*,Auto">
            <Panel Grid.Row="0">
            <Rectangle Fill="#4207080A" IsHitTestVisible="False"/>
            <Rectangle Fill="#08000000" IsHitTestVisible="False"/>

            <ListBox x:Name="FileList"
                     DoubleTapped="OnListDoubleTapped"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackDisplayItem">
                        <Grid RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0"
                                    Classes="track-card"
                                    CornerRadius="7"
                                    Padding="4,3">
                                <Panel>
                                <Border Background="{Binding PlayingBackground}"
                                        CornerRadius="7"
                                        IsHitTestVisible="False"/>
                                <Grid ColumnDefinitions="4,52,*">

                                    <Border Grid.Column="0"
                                            Width="3" Height="34"
                                            CornerRadius="2"
                                            Margin="0,8"
                                            Background="{Binding PlayingAccent}"
                                            VerticalAlignment="Center"/>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="1"
                                            Width="42" Height="42"
                                            CornerRadius="6" ClipToBounds="True"
                                            Margin="8,0,12,0" VerticalAlignment="Center"
                                            Background="#262B32">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Two-line hierarchy: track identity, then source and classification. -->
                                    <Grid Grid.Column="2"
                                          VerticalAlignment="Center"
                                          ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="4">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*">
                                            <Border Background="{Binding RatingBackground}"
                                                    BorderBrush="{Binding RatingBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Height="18"
                                                    Padding="5,0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingText}"
                                                           FontSize="9.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="#DCE6EF"/>
                                            </Border>
                                            <Image Grid.Column="1"
                                                   Source="{SvgImage /Assets/public.svg}"
                                                   IsVisible="{Binding Track.IsPublic}"
                                                   Width="13" Height="13"
                                                   Margin="0,0,6,0"
                                                   Opacity="0.9"
                                                   ToolTip.Tip="Public track"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Track.Title}"
                                                   Foreground="{Binding TitleBrush}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding ChannelText}"
                                                       FontSize="10.5" Opacity="0.5"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ChannelSeparatorText}"
                                                       FontSize="10.5" Opacity="0.38"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" MaxWidth="610">
                                                <TextBlock Text="{Binding ModelGenreText}"
                                                           FontSize="11" Foreground="#65BCEB"
                                                           MaxWidth="390"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding GenreSeparatorText}"
                                                           FontSize="11"
                                                           Opacity="0.42"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ManualGenreText}"
                                                           FontSize="11"
                                                           Foreground="#A9BAC8"
                                                           Opacity="0.78"
                                                           MaxWidth="210"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <views:TrackTagSummaryControl Tags="{Binding TagDisplays}"
                                                                          Grid.Column="3"
                                                                          Margin="12,0,8,0"
                                                                          HorizontalAlignment="Stretch"/>
                                        </Grid>
                                        <TextBlock Grid.RowSpan="2"
                                                   Grid.Column="1"
                                                   Text="{Binding DurationText}"
                                                   FontSize="10.5"
                                                   Opacity="0.62"
                                                   Margin="15,0,15,0"
                                                   MinWidth="42"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </Grid>
                                </Panel>
                            </Border>
                            <Rectangle Grid.Row="1" Height="1" Fill="#222D36" Margin="18,3,18,3"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="OnContextEditClicked"/>
                        <MenuItem Header="Toggle review mark" Click="OnContextToggleReviewClicked"/>
                        <MenuItem Header="Toggle automatic analysis" Click="OnContextToggleAnalysisClicked"/>
                        <Separator/>
                        <MenuItem Header="Delete track (including file)" Click="OnContextDeleteClicked"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            </Panel>

            <!-- ── Player bar ── -->
            <Border x:Name="PlayerBar"
                    Grid.Row="1"
                    ZIndex="30"
                    Height="118"
                    Padding="0"
                    Background="Transparent"
                    ClipToBounds="False"
                    CornerRadius="10,10,0,0"
                    BorderThickness="0"
                    BoxShadow="0 -6 16 2 #7A000000">
                <Border CornerRadius="10,10,0,0"
                        ClipToBounds="True">
                    <Panel>
                        <Image x:Name="PlayerArtworkBackground"
                               IsVisible="False"
                               IsHitTestVisible="False"
                               Height="118"
                               VerticalAlignment="Stretch"
                               Opacity="0.42"
                               Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                            </Image.RenderTransform>
                            <Image.Effect>
                                <BlurEffect Radius="22"/>
                            </Image.Effect>
                        </Image>
                        <Border Background="#98070A0E"
                                CornerRadius="10,10,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PlayerAtmosphereTint"
                                Background="#00000000"
                                CornerRadius="10,10,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PlayerChromeEdge"
                                Height="1"
                                Margin="10,0"
                                CornerRadius="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="#30283A46"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PlayerTopGlow"
                                Height="0"
                                CornerRadius="10,10,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="#00000000"
                                IsHitTestVisible="False"/>
                        <Grid Margin="16,8,16,10"
                              RowDefinitions="22,28,*"
                              RowSpacing="3">

                            <Border x:Name="UpcomingBar"
                                    Grid.Row="0"
                                    IsVisible="False"
                                    Padding="4,0,4,0">
                                <DockPanel>
                                    <TextBlock x:Name="CrossfadeStatusText"
                                               DockPanel.Dock="Right"
                                               IsVisible="False"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Next:"
                                                   FontSize="11" Opacity="0.4"/>
                                        <TextBlock x:Name="UpcomingTrackText"
                                                   FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid x:Name="PlaybackInfoPanel"
                                  Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  Height="28"
                                  IsVisible="False">
                                <Border Grid.Column="0"
                                        ClipToBounds="False">
                                    <Slider x:Name="PlaybackSlider"
                                            Classes="playback"
                                            Minimum="0" Maximum="100" Value="0"
                                            Margin="0,-5,0,0"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="PlaybackTimeText"
                                           Grid.Column="1"
                                           Text="" FontSize="11" Opacity="0.55"
                                           Margin="10,0,0,0" MinWidth="86"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*,Auto"
                                  Height="42">

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Classes="icon"
                                            Click="OnPreviousClicked"
                                            ToolTip.Tip="Previous track">
                                        <Image Source="{SvgImage /Assets/skip-back.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                    <Button x:Name="PlayPauseBtn"
                                            Classes="icon"
                                            Click="OnPlayPauseClicked"
                                            ToolTip.Tip="Play / Pause">
                                        <Grid Width="26" Height="26">
                                            <Image x:Name="PlayIcon"
                                                   Source="{SvgImage /Assets/play.svg}"/>
                                            <Image x:Name="PauseIcon"
                                                   Source="{SvgImage /Assets/pause.svg}"
                                                   IsVisible="False"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="icon"
                                            Click="OnNextClicked"
                                            ToolTip.Tip="Next track">
                                        <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           x:Name="NowPlayingText"
                                           Text=""
                                           FontStyle="Italic" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,18,0"
                                           Padding="0,0,4,0"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <Border ClipToBounds="False">
                                        <Slider x:Name="VolumeSlider"
                                                Classes="playback"
                                                Minimum="0" Maximum="100" 
                                                Opacity="0.6"
                                                Value="100"
                                                Width="108"
                                                Height="28"
                                                Margin="0,-5,0,0"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="ShuffleBtn"
                                            Classes="icon"
                                            Click="OnShuffleToggleClicked"
                                            Opacity="0.35"
                                            ToolTip.Tip="Shuffle: Off">
                                        <Image Source="{SvgImage /Assets/shuffle.svg}"
                                               Width="17" Height="17"/>
                                    </Button>
                                    <Button x:Name="ReviewBtn"
                                            Classes="icon"
                                            Click="OnReviewToggleClicked"
                                            Opacity="0.35"
                                            ToolTip.Tip="Mark for review">
                                        <Image Source="{SvgImage /Assets/review.svg}"
                                               Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Panel>
                </Border>
            </Border>

            <!-- ── Filter workspace overlay ── -->
            <Border x:Name="FilterDrawer"
                    Grid.Row="0"
                    ZIndex="40"
                    IsVisible="False"
                    Background="#D20D0F12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#25313D">
                <Grid RowDefinitions="Auto,*" Margin="30,22,30,26">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Build reusable presets from ratings, model genres and tags."
                                       FontSize="11" Opacity="0.62"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Click="OnClearFiltersClicked"
                                Background="Transparent"
                                BorderBrush="#314B5F"
                                BorderThickness="1"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                FontSize="11"
                                Opacity="0.72"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                Click="OnToggleFiltersClicked"
                                Classes="icon"
                                ToolTip.Tip="Close filters"
                                Opacity="0.7"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="24">
                        <Border Background="#B80B0D10"
                                BorderBrush="#263442"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="PRESETS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.42" LetterSpacing="1"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="AddPresetButton"
                                                Content="+"
                                                Click="OnAddPresetClicked"
                                                Width="28"
                                                Height="26"
                                                Padding="0"
                                                Background="#101923"
                                                BorderBrush="#314B5F"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                FontSize="14"
                                                ToolTip.Tip="Create preset"/>
                                    </Grid>
                                    <StackPanel x:Name="PresetRows" Spacing="7"/>
                                    <Grid x:Name="PresetActionsPanel"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          IsVisible="False">
                                        <Button Grid.Column="0"
                                                Content="Update selected"
                                                Click="OnUpdatePresetClicked"
                                                Background="#12334A"
                                                BorderBrush="#2D6E96"
                                                BorderThickness="1"
                                                Padding="10,6"
                                                FontSize="11"/>
                                        <Button Grid.Column="1"
                                                Content="Delete"
                                                Click="OnDeletePresetClicked"
                                                Background="Transparent"
                                                BorderBrush="#314B5F"
                                                BorderThickness="1"
                                                Padding="10,6"
                                                FontSize="11"
                                                Opacity="0.75"/>
                                    </Grid>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#25313D"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="SORT"
                                               FontSize="10" FontWeight="SemiBold"
                                               Opacity="0.42" LetterSpacing="1"/>
                                    <Border Background="#0F1C27"
                                            BorderBrush="#2D6E96"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="4">
                                        <Grid ColumnDefinitions="*,1,36">
                                            <ComboBox x:Name="SortByBox"
                                                      Grid.Column="0"
                                                      Height="30"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Foreground="#78C7EE"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,3"
                                                      SelectionChanged="OnSortChanged"/>
                                            <Rectangle Grid.Column="1"
                                                       Fill="#24475D"
                                                       Margin="2,5"/>
                                            <Button x:Name="SortDirectionButton"
                                                    Grid.Column="2"
                                                    Content="↑"
                                                    Click="OnSortDirectionClicked"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#78C7EE"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Padding="0"
                                                    ToolTip.Tip="Toggle sort direction"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#25313D"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="RATING"
                                               FontSize="10" FontWeight="SemiBold"
                                               Opacity="0.42" LetterSpacing="1"/>
                                    <views:MultiSelectFilterControl x:Name="RatingFilter"
                                                                    Placeholder="All ratings"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#25313D"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="VISIBILITY"
                                               FontSize="10" FontWeight="SemiBold"
                                               Opacity="0.42" LetterSpacing="1"/>
                                    <views:MultiSelectFilterControl x:Name="VisibilityFilter"
                                                                    Placeholder="All visibility"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#25313D"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="CONDITIONS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Opacity="0.42"
                                               LetterSpacing="1"/>
                                    <StackPanel x:Name="FilterGroupsPanel" Spacing="8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#A80B0D10"
                                BorderBrush="#263442"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Filter conditions" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Select genres and tags, then add them as one OR condition."
                                                   FontSize="11" Opacity="0.56"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="＋ Add condition"
                                            Click="OnAddFilterGroupClicked"
                                            Background="#0D151D"
                                            BorderBrush="#314B5F"
                                            BorderThickness="1"
                                            Padding="11,7"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="FilterBuilderPanel" Spacing="12"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <views:AddTrackOverlay x:Name="AddTrackOverlay" Grid.Row="0" IsVisible="False"/>

        </Grid>

    </DockPanel>

    <views:ChannelOverlay x:Name="ChannelOverlay" IsVisible="False" ZIndex="65"/>

    <!-- Queue management is a workspace, not a small dialog. It deliberately stops above the player. -->
    <views:ImportOverlay x:Name="ImportOverlay" IsVisible="False" ZIndex="70"/>

    <!-- Covers the toolbar as well as the list while track details are open. -->
    <views:EditTrackOverlay x:Name="EditTrackOverlay" IsVisible="False" ZIndex="80"/>

    <views:SettingsOverlay x:Name="SettingsOverlay" IsVisible="False" ZIndex="90"/>

    <Border x:Name="Toast"
            IsVisible="False"
            ZIndex="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,104,0,0"
            Background="#E6101821"
            BorderBrush="#314B5F"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,9"
            BoxShadow="0 8 24 2 #66000000">
        <TextBlock x:Name="ToastText"
                   FontSize="12"
                   Foreground="#EAF3FA"/>
    </Border>

    </Panel>

</UserControl>
