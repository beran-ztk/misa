<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Music.Models"
             xmlns:views="clr-namespace:Music.Views"
             x:Class="Music.Views.MusicView">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2430"/>
            <Setter Property="BorderBrush" Value="#516174"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#3D4652"/>
            <Setter Property="Background" Value="#0B0D10"/>
            <Setter Property="Foreground" Value="#F6F8FA"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#1E9AF0"/>
            <Setter Property="Background" Value="#33404A"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#26313A"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#22262C"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#183A57"/>
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True"
               Background="#121417">

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="#0A0B0D"
                BorderBrush="#16212C"
                BorderThickness="0,0,0,1"
                Padding="20,12,16,10">
            <Grid ColumnDefinitions="*,Auto">

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">

                <Button Content="＋"
                        Click="OnAddTrackClicked"
                        ToolTip.Tip="Add Track"
                        Width="34" Height="34"
                        BorderThickness="1"
                        Background="#10151B"
                        Padding="0" FontSize="16"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

                <TextBox x:Name="SearchBox"
                         Watermark="Search…"
                         Width="230" Height="34"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="FiltersToggleBtn"
                        Content="Filter"
                        Click="OnToggleFiltersClicked"
                        Background="#10151B"
                        BorderThickness="1"
                        Height="34" Padding="16,0"
                        ToolTip.Tip="Open filter panel"
                        VerticalContentAlignment="Center"/>

            </StackPanel>
            </Grid>
        </Border>

        <!-- ── Active filter chips (hidden when no filters active) ── -->
        <ItemsControl x:Name="ActiveFilterChips"
                      DockPanel.Dock="Top"
                      IsVisible="False"
                      Margin="20,0,16,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2,4,2" Padding="9,3"
                            CornerRadius="10"
                            BorderBrush="#32808080" BorderThickness="1"
                            Background="#0D808080">
                        <TextBlock Text="{Binding}" FontSize="11"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Status / error text (hidden until needed) ── -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="" TextWrapping="Wrap"
                   IsVisible="False"
                   FontSize="11" Opacity="0.6"
                   Margin="20,0,16,6"/>

        <!-- ── Player bar ── -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,10,16,14"
                Background="#07080A"
                BorderThickness="0,1,0,0" BorderBrush="#202832">
            <StackPanel Spacing="8">

                <Border x:Name="UpcomingBar"
                        IsVisible="False"
                        Padding="4,0,4,0">
                    <DockPanel>
                        <TextBlock x:Name="CrossfadeStatusText"
                                   DockPanel.Dock="Right"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Next:"
                                       FontSize="11" Opacity="0.4"/>
                            <TextBlock x:Name="UpcomingTrackText"
                                       FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="PlaybackInfoPanel"
                      ColumnDefinitions="*,Auto"
                      IsVisible="False">
                    <Slider x:Name="PlaybackSlider"
                            Grid.Column="0"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaybackTimeText"
                               Grid.Column="1"
                               Text="" FontSize="11" Opacity="0.55"
                               Margin="10,0,0,0" MinWidth="86"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="icon"
                                Click="OnPreviousClicked"
                                ToolTip.Tip="Previous track">
                            <Image Source="{SvgImage /Assets/skip-back.svg}"
                                   Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="PlayPauseBtn"
                                Classes="icon"
                                Click="OnPlayPauseClicked"
                                ToolTip.Tip="Play / Pause">
                            <Grid Width="18" Height="18">
                                <Image x:Name="PlayIcon"
                                       Source="{SvgImage /Assets/play.svg}"/>
                                <Image x:Name="PauseIcon"
                                       Source="{SvgImage /Assets/pause.svg}"
                                       IsVisible="False"/>
                            </Grid>
                        </Button>
                        <Button Classes="icon"
                                Click="OnNextClicked"
                                ToolTip.Tip="Next track">
                            <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                   Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               x:Name="NowPlayingText"
                               Text=""
                               FontStyle="Italic" Opacity="0.7"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <Slider x:Name="VolumeSlider"
                                Minimum="0" Maximum="100" 
                                Value="100"
                                Width="108"
                                VerticalAlignment="Center"/>
                        <Button x:Name="ShuffleBtn"
                                Classes="icon"
                                Click="OnShuffleToggleClicked"
                                Opacity="0.35"
                                ToolTip.Tip="Shuffle: Off">
                            <Image Source="{SvgImage /Assets/shuffle.svg}"
                                   Width="17" Height="17"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             Track list + filter drawer overlay (Panel fills remaining space)
             ══════════════════════════════════════════════════════ -->
        <Panel>

            <ListBox x:Name="FileList"
                     DoubleTapped="OnListDoubleTapped"
                     Background="#17191D"
                     BorderThickness="0"
                     Padding="12,8">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackDisplayItem">
                        <Border Background="{Binding PlayingBackground}"
                                CornerRadius="7"
                                Padding="8,6">
                            <Grid ColumnDefinitions="4,52,*,Auto">

                                <Border Grid.Column="0"
                                        Width="3" Height="38"
                                        CornerRadius="2"
                                        Background="{Binding PlayingAccent}"
                                        VerticalAlignment="Center"/>

                                <!-- Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="40" Height="40"
                                        CornerRadius="6" ClipToBounds="True"
                                        Margin="8,0,12,0" VerticalAlignment="Center"
                                        Background="#262B32">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- Title + genre + style -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Track.Title}"
                                               Foreground="{Binding TitleBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GenreText}"
                                               FontSize="11" Opacity="0.62"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StyleText}"
                                               FontSize="10.5" Opacity="0.38"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Right: duration / rating / counts -->
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Spacing="5"
                                            Margin="22,0,0,0"
                                            MinWidth="76">
                                    <TextBlock Text="{Binding DurationText}"
                                               FontSize="11" Opacity="0.56"
                                               HorizontalAlignment="Right"/>
                                    <Border Background="{Binding RatingBackground}"
                                            BorderBrush="{Binding RatingBorder}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RatingText}"
                                                   FontSize="10"
                                                   Foreground="#DCE6EF"/>
                                    </Border>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="OnContextEditClicked"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- ── Filter drawer (right-side overlay) ── -->
            <Border x:Name="FilterDrawer"
                    Width="310" HorizontalAlignment="Right"
                    IsVisible="False"
                    Background="#101216"
                    BorderThickness="1,0,0,0" BorderBrush="#2B3642"
                    BoxShadow="-10 0 34 0 #77000000">
                <DockPanel LastChildFill="True">

                    <!-- Header (docked top) -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
                          Margin="16,13,10,13">
                        <TextBlock Grid.Column="0"
                                   Text="Filters"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Clear all"
                                Click="OnClearFiltersClicked"
                                Padding="8,4" FontSize="11"
                                Opacity="0.6"
                                Background="Transparent"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                Click="OnToggleFiltersClicked"
                                Padding="8,4" FontSize="11"
                                Opacity="0.5"
                                Background="Transparent"
                                Margin="2,0,0,0"/>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top"
                               Height="1" Fill="#18808080"/>

                    <!-- Footer (docked bottom, always visible) -->
                    <Border DockPanel.Dock="Bottom"
                            BorderThickness="0,1,0,0" BorderBrush="#14808080"
                            Padding="16,10,16,12">
                        <Button Content="＋ Add group"
                                Click="OnAddFilterGroupClicked"
                                Padding="10,6" FontSize="11"
                                HorizontalAlignment="Left"/>
                    </Border>

                    <!-- Scrollable filter sections (fills remaining space) -->
                    <ScrollViewer Padding="16,14,16,10">
                        <StackPanel Spacing="20">

                            <!-- Rating -->
                            <StackPanel Spacing="7">
                                <TextBlock Text="RATING"
                                           FontSize="10" FontWeight="SemiBold"
                                           Opacity="0.38" LetterSpacing="1"/>
                                <views:MultiSelectFilterControl x:Name="RatingFilter"
                                                                Placeholder="---"/>
                            </StackPanel>

                            <!-- Tags -->
                            <StackPanel Spacing="0">
                                <TextBlock Text="TAGS"
                                           FontSize="10" FontWeight="SemiBold"
                                           Opacity="0.38" LetterSpacing="1"
                                           Margin="0,0,0,10"/>
                                <StackPanel x:Name="FilterGroupsPanel" Spacing="0"/>
                            </StackPanel>
                            <Border Height="30"/>
                        </StackPanel>
                        
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- Add track overlay (always on top) -->
            <views:AddTrackOverlay x:Name="AddTrackOverlay" IsVisible="False"/>

        </Panel>

    </DockPanel>

</UserControl>
