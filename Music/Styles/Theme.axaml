<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base canvas and layered surfaces -->
    <SolidColorBrush x:Key="Theme.Brush.Background">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Overlay">#E8141414</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Navigation">#B0181818</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Surface">#181818</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.SurfaceRaised">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.SurfaceTranslucent">#A81E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.SurfaceHover">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.SurfaceSelected">#363636</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.AccentSurface">#3A3A3A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Input">#7A111111</SolidColorBrush>

    <!-- Borders and separators -->
    <SolidColorBrush x:Key="Theme.Brush.BorderSubtle">#363636</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Border">#3D3D3D</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.BorderStrong">#464646</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Divider">#333333</SolidColorBrush>

    <!-- Typography -->
    <SolidColorBrush x:Key="Theme.Brush.TextPrimary">#F0EFE5</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.TextStrong">#F7F3E8</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.TextSecondary">#C3C3BE</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.TextMuted">#B7B7B1</SolidColorBrush>

    <!-- Semantic colors -->
    <SolidColorBrush x:Key="Theme.Brush.Accent">#848484</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.AccentStrong">#949494</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Success">#6F7D59</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Warning">#FFD27A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.Danger">#EE5C5C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.DangerSurface">#52252B</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.DangerBorder">#A34D57</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Brush.DangerText">#F0A7AE</SolidColorBrush>

    <!-- Shared geometry -->
    <CornerRadius x:Key="Theme.Corner.Small">5</CornerRadius>
    <CornerRadius x:Key="Theme.Corner.Control">6</CornerRadius>
    <CornerRadius x:Key="Theme.Corner.Card">8</CornerRadius>
    <CornerRadius x:Key="Theme.Corner.Pill">14</CornerRadius>
</ResourceDictionary>
