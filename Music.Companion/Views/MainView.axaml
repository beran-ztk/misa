<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Music.Companion.Views"
             x:Class="Music.Companion.Views.MainView">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0B0D10"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#111821"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toolbarIcon">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#26313A"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#183A57"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#1E9AF0"/>
            <Setter Property="Background" Value="#33404A"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Background="#121417">

        <Border DockPanel.Dock="Top"
                Background="#080A0D"
                BorderBrush="#182432"
                BorderThickness="0,0,0,1"
                Padding="14,12,14,10">
            <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Music"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="ImportButton"
                            Classes="toolbarIcon"
                            Click="OnImportClicked"
                            ToolTip.Tip="Import">
                        <Image Source="{SvgImage /Assets/import.svg}"
                               Width="19" Height="19"/>
                    </Button>
                    <Button Grid.Column="2"
                            x:Name="ReloadButton"
                            Classes="toolbarIcon"
                            Click="OnReloadClicked"
                            ToolTip.Tip="Reload">
                        <Image Source="{SvgImage /Assets/reload.svg}"
                               Width="19" Height="19"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SearchBox"
                             Watermark="Search..."
                             Height="38"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="FilterButton"
                            Classes="toolbarIcon"
                            Click="OnToggleFiltersClicked"
                            ToolTip.Tip="Filters">
                        <Image Source="{SvgImage /Assets/filter.svg}"
                               Width="19" Height="19"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="11"
                           Opacity="0.62"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#07080A"
                BorderBrush="#202832"
                BorderThickness="0,1,0,0"
                Padding="14,8,14,12">
            <StackPanel Spacing="7">
                <TextBlock x:Name="NowPlayingText"
                           Text=""
                           HorizontalAlignment="Center"
                           FontStyle="Italic"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider x:Name="ProgressSlider"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="100"
                            Value="0"/>
                    <TextBlock x:Name="TimeText"
                               Grid.Column="1"
                               Text="00:00 / 00:00"
                               FontSize="11"
                               Opacity="0.62"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Center">
                        <Button x:Name="PreviousButton"
                                Classes="icon"
                                Click="OnPreviousClicked"
                                ToolTip.Tip="Previous">
                            <Image Source="{SvgImage /Assets/skip-back.svg}"
                                   Width="19" Height="19"/>
                        </Button>
                        <Button x:Name="PlayPauseButton"
                                Classes="icon"
                                Click="OnPlayPauseClicked"
                                ToolTip.Tip="Play / Pause">
                            <Grid Width="19" Height="19">
                                <Image x:Name="PlayIcon"
                                       Source="{SvgImage /Assets/play.svg}"/>
                                <Image x:Name="PauseIcon"
                                       Source="{SvgImage /Assets/pause.svg}"
                                       IsVisible="False"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NextButton"
                                Classes="icon"
                                Click="OnNextClicked"
                                ToolTip.Tip="Next">
                            <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                   Width="19" Height="19"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="ShuffleButton"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Classes="icon"
                            Opacity="0.45"
                            Click="OnShuffleClicked"
                            ToolTip.Tip="Shuffle">
                        <Image Source="{SvgImage /Assets/shuffle.svg}"
                               Width="18" Height="18"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Panel>
            <ListBox x:Name="TrackList"
                     Background="#17191D"
                     BorderThickness="0"
                     DoubleTapped="OnTrackDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="44,*,Auto">
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="#262B32"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <Image Source="{Binding Cover}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding GenreText}"
                                           FontSize="11"
                                           Opacity="0.62"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StyleText}"
                                           FontSize="10"
                                           Opacity="0.42"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="16,0,0,0">
                                <TextBlock Text="{Binding DurationText}"
                                           FontSize="11"
                                           Opacity="0.58"
                                           HorizontalAlignment="Right"/>
                                <Border CornerRadius="5"
                                        Padding="7,2"
                                        Background="#26313A"
                                        BorderBrush="#3D4B59"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Rating}"
                                               FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="FilterDrawer"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    Width="330"
                    Background="#101216"
                    BorderBrush="#2B3642"
                    BorderThickness="1,0,0,0"
                    BoxShadow="-10 0 34 0 #77000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          Margin="16,13,10,13">
                        <TextBlock Text="Filters"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Click="OnClearFiltersClicked"
                                Padding="8,4"
                                FontSize="12"
                                Opacity="0.65"
                                Background="Transparent"/>
                        <Button Grid.Column="2"
                                Click="OnToggleFiltersClicked"
                                ToolTip.Tip="Close"
                                Padding="8,4"
                                FontSize="12"
                                Opacity="0.55"
                                Background="Transparent">
                            <TextBlock Text="x"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Padding="16,12,16,12">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock Text="RATING"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Opacity="0.45"/>
                                <views:MultiSelectFilterControl x:Name="RatingFilter"
                                                                Placeholder="All ratings"/>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Text="GROUPS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Opacity="0.45"/>
                                <StackPanel x:Name="FilterGroupsPanel"
                                            Spacing="0"/>
                            </StackPanel>
                            <Border Height="60"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#26313A"
                            Padding="16,10,16,12">
                        <Button Content="+ Add group"
                                Click="OnAddFilterGroupClicked"
                                Padding="10,6"
                                HorizontalAlignment="Left"/>
                    </Border>
                </Grid>
            </Border>
        </Panel>

    </DockPanel>
</UserControl>
