<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Music.Companion.Views"
             x:Class="Music.Companion.Views.MainView">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toolbarIcon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryPlayer">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Divider}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource Mobile.Brush.Background}">

        <Image x:Name="AppArtworkPreviousBackground"
               Grid.RowSpan="3"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               IsVisible="False"
               Opacity="0">
            <Image.Effect>
                <BlurEffect Radius="18"/>
            </Image.Effect>
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="AppArtworkBackground"
               Grid.RowSpan="3"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               IsVisible="False"
               Opacity="0">
            <Image.Effect>
                <BlurEffect Radius="16"/>
            </Image.Effect>
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
            </Image.RenderTransform>
        </Image>
        <Border Grid.RowSpan="3" IsHitTestVisible="False" Background="#78181713"/>
        <Border x:Name="AppAtmosphereTint" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#342F412B" Offset="0"/>
                    <GradientStop Color="#001B1914" Offset="0.48"/>
                    <GradientStop Color="#242A253C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border Grid.Row="0"
                Background="#0C1B1914"
                BorderBrush="{DynamicResource Mobile.Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,6,12,6">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <Border Width="3" Height="18"
                            CornerRadius="2"
                            Background="{DynamicResource Mobile.Brush.AccentStrong}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="LIBRARY"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.1"/>
                        <TextBlock x:Name="PlaylistSummaryText"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                   Opacity="0.78"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ImportButton" Classes="toolbarIcon"
                            Click="OnImportClicked" ToolTip.Tip="Import library">
                        <Image Source="{SvgImage /Assets/import.svg}" Width="17" Height="17"/>
                    </Button>
                    <Button Grid.Column="3" x:Name="SearchButton" Classes="toolbarIcon"
                            Click="OnToggleSearchClicked" Opacity="0.72" ToolTip.Tip="Search">
                        <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                    </Button>
                    <Button Grid.Column="4" x:Name="ReviewFilterButton" Classes="toolbarIcon"
                            Click="OnReviewFilterClicked" Opacity="0.5" ToolTip.Tip="Reviews">
                        <Image Source="{SvgImage /Assets/review.svg}" Width="17" Height="17"/>
                    </Button>
                    <Button Grid.Column="5" x:Name="FilterButton" Classes="toolbarIcon"
                            Click="OnToggleFiltersClicked" ToolTip.Tip="Filters">
                        <Image Source="{SvgImage /Assets/filter.svg}" Width="18" Height="18"/>
                    </Button>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1" Grid.ColumnSpan="2"
                             ZIndex="4"
                             IsVisible="False"
                             Watermark="Search tracks"
                             Height="38"
                             Margin="0,0,1,0"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1">
            <Rectangle Fill="#0C1B1914" IsHitTestVisible="False"/>
            <ListBox x:Name="TrackList"
                     Margin="8,3"
                     Background="Transparent"
                     BorderThickness="0"
                     Tapped="OnTrackTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,1">
                            <Border Background="{Binding CurrentBackground}"
                                    CornerRadius="7"
                                    Padding="7,6">
                                <Grid ColumnDefinitions="3,42,*,Auto" ColumnSpacing="8">
                                    <Border Width="3" Height="34"
                                            CornerRadius="2"
                                            Background="{Binding CurrentAccent}"
                                            VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Width="40" Height="40"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Mobile.Brush.SurfaceRaised}"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="2"
                                          VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Border Width="52"
                                                    CornerRadius="4"
                                                    Padding="5,2"
                                                    Background="{DynamicResource Mobile.Brush.SurfaceRaised}"
                                                    BorderBrush="{DynamicResource Mobile.Brush.BorderSubtle}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rating}"
                                                           FontSize="9.5"
                                                           TextAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="14.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Mobile.Brush.TextStrong}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Image Grid.Column="2"
                                                   Source="{SvgImage /Assets/review.svg}"
                                                   Width="11" Height="11"
                                                   Opacity="0.72"
                                                   IsVisible="{Binding IsMarkedForReview}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding MetadataText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Mobile.Brush.TextSecondary}"
                                                   Opacity="0.82"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DurationText}"
                                               Margin="5,0,1,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="54,0,12,0"
                                    Background="{DynamicResource Mobile.Brush.Divider}"
                                    Opacity="0.55"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusText"
                       ZIndex="24"
                       IsVisible="False"
                       Margin="14,8"
                       Padding="9,5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       MaxWidth="760"
                       Background="#D8262119"
                       Foreground="{DynamicResource Mobile.Brush.Warning}"
                       FontSize="10.5"
                       TextWrapping="Wrap"/>

            <Border x:Name="FilterDrawer"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    Width="340"
                    MaxWidth="340"
                    Background="{DynamicResource Mobile.Brush.Navigation}"
                    BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                    BorderThickness="1,0,0,0"
                    BoxShadow="-12 0 34 0 #88000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,14,10,12">
                        <StackPanel Spacing="1">
                            <TextBlock Text="FILTERS" FontSize="14" FontWeight="SemiBold" LetterSpacing="0.8"/>
                            <TextBlock Text="Refine the current library" FontSize="10" Foreground="{DynamicResource Mobile.Brush.TextMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset" Click="OnClearFiltersClicked"
                                Padding="9,5" FontSize="11" Background="Transparent" BorderThickness="0"/>
                        <Button Grid.Column="2" Click="OnToggleFiltersClicked" ToolTip.Tip="Close"
                                Width="34" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="16,8,16,16">
                        <StackPanel Spacing="17">
                            <StackPanel Spacing="6">
                                <TextBlock Text="PRESET" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Brush.TextMuted}"/>
                                <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetSelectionChanged"
                                          Height="38" Padding="9,4"/>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock Text="COMPLETION" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Brush.TextMuted}"/>
                                <CheckBox x:Name="ReviewOnlyFilterBox"
                                          Content="Needs review only"
                                          IsCheckedChanged="OnReviewOnlyFilterChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="RATING" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Brush.TextMuted}"/>
                                <views:MultiSelectFilterControl x:Name="RatingFilter" Placeholder="All except Avoid"/>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock Text="CONDITIONS" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Brush.TextMuted}"/>
                                <StackPanel x:Name="FilterGroupsPanel" Spacing="0"/>
                            </StackPanel>
                            <Border Height="28"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Mobile.Brush.BorderSubtle}"
                            Padding="16,10,16,13">
                        <Button Content="+ Add condition group"
                                Click="OnAddFilterGroupClicked"
                                Padding="11,7"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="Toast"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#F02A261D"
                    BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,9">
                <TextBlock x:Name="ToastText" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
        </Panel>

        <Border Grid.Row="2"
                Background="#B823211B"
                BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                BorderThickness="0,1,0,0"
                CornerRadius="12,12,0,0"
                ClipToBounds="True"
                BoxShadow="0 -7 20 0 #70000000">
            <Panel>
                <Image x:Name="PlayerArtworkPreviousBackground"
                       MaxHeight="150"
                       Stretch="UniformToFill" IsHitTestVisible="False"
                       IsVisible="False" Opacity="0">
                    <Image.Effect><BlurEffect Radius="12"/></Image.Effect>
                    <Image.RenderTransform><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Image.RenderTransform>
                </Image>
                <Image x:Name="PlayerArtworkBackground"
                       MaxHeight="150"
                       Stretch="UniformToFill" IsHitTestVisible="False"
                       IsVisible="False" Opacity="0">
                    <Image.Effect><BlurEffect Radius="10"/></Image.Effect>
                    <Image.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Image.RenderTransform>
                </Image>
                <Border IsHitTestVisible="False" Background="#A91B1914"/>
                <Border x:Name="PlayerAtmosphereTint" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#4A435B36" Offset="0"/>
                            <GradientStop Color="#161B1914" Offset="0.55"/>
                            <GradientStop Color="#3A342D50" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="14,8,14,10">
                    <Grid ColumnDefinitions="46,*" ColumnSpacing="9">
                        <Border Width="42" Height="42" CornerRadius="7" ClipToBounds="True"
                                Background="{DynamicResource Mobile.Brush.Surface}"
                                BorderBrush="{DynamicResource Mobile.Brush.Border}"
                                BorderThickness="1">
                            <Image x:Name="NowPlayingCover" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingText"
                                       Text="Nothing playing"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NowPlayingMetaText"
                                       Text="Choose a track"
                                       FontSize="10"
                                       Foreground="{DynamicResource Mobile.Brush.TextSecondary}"
                                       Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="TimeText" Grid.Column="1"
                                   Text="00:00 / 00:00" FontSize="9.5"
                                   Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="1">
                    <Button x:Name="PreviousButton" Grid.Column="0" Classes="icon"
                            Width="36" Height="34"
                            Click="OnPreviousClicked" ToolTip.Tip="Previous">
                        <Image Source="{SvgImage /Assets/skip-back.svg}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="PlayPauseButton" Grid.Column="1" Classes="primaryPlayer"
                            Width="36" Height="34"
                            Click="OnPlayPauseClicked" ToolTip.Tip="Play / Pause">
                        <Grid Width="18" Height="18">
                            <Image x:Name="PlayIcon" Source="{SvgImage /Assets/play.svg}"/>
                            <Image x:Name="PauseIcon" Source="{SvgImage /Assets/pause.svg}" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton" Grid.Column="2" Classes="icon"
                            Width="36" Height="34"
                            Click="OnNextClicked" ToolTip.Tip="Next">
                        <Image Source="{SvgImage /Assets/skip-forward.svg}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="ShuffleButton" Grid.Column="4" Classes="icon"
                            Width="36" Height="34"
                            Opacity="0.45" Click="OnShuffleClicked" ToolTip.Tip="Shuffle">
                        <Image Source="{SvgImage /Assets/shuffle.svg}" Width="17" Height="17"/>
                    </Button>
                    <Button x:Name="ReviewButton" Grid.Column="5" Classes="icon"
                            Width="36" Height="34"
                            Opacity="0.45" Click="OnReviewClicked" ToolTip.Tip="Mark for review">
                        <Image Source="{SvgImage /Assets/review.svg}" Width="17" Height="17"/>
                    </Button>
                    </Grid>
                </Grid>
            </Panel>
        </Border>
    </Grid>
</UserControl>
