<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Music.Companion.Views.MainView">

    <UserControl.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#0B0D10"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#111821"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#26313A"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#183A57"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#1E9AF0"/>
            <Setter Property="Background" Value="#33404A"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Background="#121417">

        <Border DockPanel.Dock="Top"
                Background="#080A0D"
                BorderBrush="#182432"
                BorderThickness="0,0,0,1"
                Padding="14,12,14,10">
            <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Music"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="ImportButton"
                            Content="Import"
                            Click="OnImportClicked"
                            Padding="12,6"/>
                    <Button Grid.Column="2"
                            x:Name="ReloadButton"
                            Content="Reload"
                            Click="OnReloadClicked"
                            Padding="12,6"/>
                </Grid>
                <TextBox x:Name="SearchBox"
                         Watermark="Search..."
                         Height="38"
                         VerticalContentAlignment="Center"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <ComboBox x:Name="RatingFilter" Grid.Column="0"/>
                    <ComboBox x:Name="GenreFilter" Grid.Column="1"/>
                    <ComboBox x:Name="StyleFilter" Grid.Column="2"/>
                </Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="11"
                           Opacity="0.62"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#07080A"
                BorderBrush="#202832"
                BorderThickness="0,1,0,0"
                Padding="14,8,14,12">
            <StackPanel Spacing="7">
                <TextBlock x:Name="NowPlayingText"
                           Text=""
                           HorizontalAlignment="Center"
                           FontStyle="Italic"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0"/>
                    <TextBlock x:Name="TimeText"
                               Grid.Column="1"
                               Text="00:00 / 00:00"
                               Margin="10,0,0,0"
                               FontSize="11"
                               Opacity="0.62"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button x:Name="PreviousButton"
                            Content="Previous"
                            Click="OnPreviousClicked"/>
                    <Button x:Name="PlayPauseButton"
                            Grid.Column="1"
                            Content="Play"
                            Click="OnPlayPauseClicked"/>
                    <Button x:Name="NextButton"
                            Grid.Column="2"
                            Content="Next"
                            Click="OnNextClicked"/>
                </Grid>
            </StackPanel>
        </Border>

        <ListBox x:Name="TrackList"
                 Background="#17191D"
                 BorderThickness="0"
                 DoubleTapped="OnTrackDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GenreText}"
                                       FontSize="11"
                                       Opacity="0.62"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StyleText}"
                                       FontSize="10"
                                       Opacity="0.42"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="16,0,0,0">
                            <TextBlock Text="{Binding DurationText}"
                                       FontSize="11"
                                       Opacity="0.58"
                                       HorizontalAlignment="Right"/>
                            <Border CornerRadius="5"
                                    Padding="7,2"
                                    Background="#26313A"
                                    BorderBrush="#3D4B59"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding Rating}"
                                           FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
