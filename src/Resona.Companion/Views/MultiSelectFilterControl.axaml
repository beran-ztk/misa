<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Companion.Views.MultiSelectFilterControl">
    <Button x:Name="ToggleBtn"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{DynamicResource Mobile.Brush.Input}"
            BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
            Foreground="{DynamicResource Mobile.Brush.TextPrimary}"
            BorderThickness="1"
            CornerRadius="7"
            Margin="0"
            Padding="10,7">
        <Button.Flyout>
            <Flyout Placement="Bottom">
                <Flyout.FlyoutPresenterTheme>
                    <ControlTheme TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="7"/>
                    </ControlTheme>
                </Flyout.FlyoutPresenterTheme>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
