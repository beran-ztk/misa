<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Resona/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ContextMenu.track-context">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Background" Value="#FA29292E"/>
            <Setter Property="BorderBrush" Value="#4AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="MenuItem.track-context-item">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="MenuItem.track-context-item:pointerover">
            <Setter Property="Background" Value="#3C3C43"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="MenuItem.track-context-item:pressed">
            <Setter Property="Background" Value="#45454D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="MenuItem.track-context-item:disabled">
            <Setter Property="Opacity" Value="0.42"/>
        </Style>
        <Style Selector="Separator.track-context-separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="#38FFFFFF"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#FC1E1E20"/>
            <Setter Property="BorderBrush" Value="#48FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="TextBox.theme-input">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.theme-input:focus">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
        </Style>
        <Style Selector="Button.auto-toggle">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style Selector="Button.auto-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
        </Style>
        <Style Selector="Button.auto-toggle.active">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
        </Style>
        <Style Selector="Button.auto-toggle.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceSelected}"/>
        </Style>
        <Style Selector="FlyoutPresenter.player-actions">
            <Setter Property="Width" Value="230"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="Button.player-action">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.player-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="ToggleButton.metadata-chip">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Pill}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.metadata-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
        </Style>
        <Style Selector="ToggleButton.metadata-chip:checked">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
        </Style>
        <Style Selector="Button.more-button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
        </Style>
        <Style Selector="Button.more-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
        </Style>
    </Application.Styles>
</Application>
