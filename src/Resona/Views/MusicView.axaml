<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Resona.Models"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.MusicView">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:checked">
            <Setter Property="Background" Value="#343E6591"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#343E6591"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.bare-add">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.bare-add:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Opacity" Value="0.58"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter:pointerover">
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter:checked">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter.review:checked">
            <Setter Property="Background" Value="#24FFD27A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter.analysis:checked">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.DangerSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.DangerBorder}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.playback">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.playback /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Slider.playback:pointerover /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Background" Value="#FAF9EF"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#30362D"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.track-card">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.track-card:pointerover">
            <Setter Property="Background" Value="#32262B22"/>
        </Style>
        <Style Selector="Button.queue-menu">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.track-card:pointerover Button.queue-menu">
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Button.queue-menu:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.queue-menu:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.queue-menu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.queue-menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.queue-menu:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.selection-accent">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.selection-accent">
            <Setter Property="Background" Value="#D0B7F000"/>
        </Style>
    </UserControl.Styles>

    <Panel x:Name="RootSurface">
    <Rectangle Fill="{DynamicResource Theme.Brush.Background}" IsHitTestVisible="False"/>
    <views:FocusedArtworkImage x:Name="AppArtworkPreviousBackground"
           IsVisible="False"
           IsHitTestVisible="False"
           Opacity="0"
           RenderTransformOrigin="0.5,0.5">
        <views:FocusedArtworkImage.RenderTransform>
            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
        </views:FocusedArtworkImage.RenderTransform>
        <views:FocusedArtworkImage.Effect>
            <BlurEffect Radius="20"/>
        </views:FocusedArtworkImage.Effect>
    </views:FocusedArtworkImage>
    <views:FocusedArtworkImage x:Name="AppArtworkBackground"
           IsVisible="False"
           IsHitTestVisible="False"
           Opacity="0.22"
           RenderTransformOrigin="0.5,0.5">
        <views:FocusedArtworkImage.RenderTransform>
            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
        </views:FocusedArtworkImage.RenderTransform>
        <views:FocusedArtworkImage.Effect>
            <BlurEffect Radius="20"/>
        </views:FocusedArtworkImage.Effect>
    </views:FocusedArtworkImage>
    <Rectangle x:Name="AppAtmosphereTint"
               IsHitTestVisible="False">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#24545FAF" Offset="0"/>
                <GradientStop Color="#14734FA8" Offset="0.42"/>
                <GradientStop Color="#00000000" Offset="0.82"/>
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <DockPanel LastChildFill="True">

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Theme.Brush.Navigation}"
                BorderBrush="#5B5444"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="2"
                            Height="20"
                            CornerRadius="1"
                            Background="Beige"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="LIBRARY"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   LetterSpacing="1.2"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlaylistSummaryText"
                                   Text=""
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#C8C1A9"
                                   Opacity="0.82"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LibraryDirtyText"
                                   Text="Library changed"
                                   IsVisible="False"
                                   FontSize="11"
                                   Foreground="#E6BF55"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    
                </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">

                <TextBox x:Name="SearchBox"
                         Classes="compact-search"
                         Watermark="Search…"
                         IsVisible="False"
                         Width="230" Height="32"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown"
                         LostFocus="OnSearchBoxLostFocus"/>
                
                <Button x:Name="SearchToggleBtn"
                        Classes="icon"
                        Click="OnSearchToggleClicked"
                        ToolTip.Tip="Search"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                </Button>

                <!-- These controls remain the filter state source for presets and filtering,
                     while the visible mode selector keeps the toolbar compact. -->
                <ToggleButton x:Name="ShowNeedsReviewCheckBox"
                              IsVisible="False"
                              IsChecked="False"
                              Checked="OnCompletionFilterChanged"
                              Unchecked="OnCompletionFilterChanged"/>
                <ToggleButton x:Name="ShowDeclinedCheckBox"
                              IsVisible="False"
                              IsChecked="False"
                              Checked="OnCompletionFilterChanged"
                              Unchecked="OnCompletionFilterChanged"/>

                <Button x:Name="LibraryModeButton"
                        Classes="icon"
                        ToolTip.Tip="Library mode"
                        Opacity="0.86">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterTheme>
                                <ControlTheme TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                </ControlTheme>
                            </Flyout.FlyoutPresenterTheme>
                            <Border Width="44"
                                    Padding="3"
                                    Background="#F218191C"
                                    CornerRadius="6">
                                <StackPanel Spacing="1">
                                    <Button x:Name="LibraryModeOption" Tag="Library"
                                            Click="OnLibraryModeOptionClicked"
                                            ToolTip.Tip="Library"
                                            Background="Transparent" BorderThickness="0"
                                            Width="38" Height="36" Padding="0">
                                        <TextBlock Text="≡" FontSize="19" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,-4,0,0"/>
                                    </Button>
                                    <Button x:Name="ReviewModeOption" Tag="Review"
                                            Click="OnLibraryModeOptionClicked"
                                            ToolTip.Tip="Needs review"
                                            Background="Transparent" BorderThickness="0"
                                            Width="38" Height="36" Padding="0">
                                        <Image Source="{SvgImage /Assets/review.svg}" Width="16" Height="16"
                                               Margin="3,0,0,0"/>
                                    </Button>
                                    <Button x:Name="DeclinedModeOption" Tag="Declined"
                                            Click="OnLibraryModeOptionClicked"
                                            ToolTip.Tip="Declined"
                                            Background="Transparent" BorderThickness="0"
                                            Width="38" Height="36" Padding="0">
                                        <Image Source="{SvgImage /Assets/close.svg}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <Grid Width="20" Height="20">
                        <TextBlock x:Name="LibraryModeIcon" Text="≡" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        <Image x:Name="ReviewModeIcon" IsVisible="False"
                               Source="{SvgImage /Assets/review.svg}" Width="18" Height="18"
                               Margin="3,0,0,0"/>
                        <Image x:Name="DeclinedModeIcon" IsVisible="False"
                               Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                    </Grid>
                </Button>
                
                <Button x:Name="RefreshLibraryButton"
                        Click="OnRefreshLibraryClicked"
                        Classes="icon"
                        ToolTip.Tip="Refresh library"
                        IsVisible="False"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/reload.svg}" Width="17" Height="17"/>
                </Button>
                
                <Button Click="OnImportClicked"
                        Classes="icon"
                        ToolTip.Tip="Add Tracks"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/download.svg}" Width="17" Height="17"/>
                </Button>

                <Button Click="OnChannelsClicked"
                        Classes="icon"
                        ToolTip.Tip="Channels"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/channels.svg}" Width="18" Height="18"/>
                </Button>

                <Button x:Name="ActivityCenterToggleButton"
                        Click="OnActivityCenterClicked"
                        Classes="icon"
                        ToolTip.Tip="Activity Center"
                        Opacity="0.86">
                    <Grid Width="22" Height="22">
                        <Image Source="{SvgImage /Assets/activity.svg}" Width="17" Height="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="ActivityBadge"
                                IsVisible="False"
                                MinWidth="13" Height="13"
                                Padding="2,0"
                                CornerRadius="7"
                                Background="#D75962"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-5,0">
                            <TextBlock x:Name="ActivityBadgeText"
                                       Text="0"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Classes="icon"
                        Click="OnSettingsClicked"
                        Opacity="0.86"
                        ToolTip.Tip="Settings">
                    <Image Source="{SvgImage /Assets/gear.svg}" Width="17" Height="17"/>
                </Button>

                <Button x:Name="FiltersToggleBtn"
                        Classes="icon"
                        Click="OnToggleFiltersClicked"
                        ToolTip.Tip="Open filters"
                        VerticalContentAlignment="Center"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/filter.svg}"
                           Width="17" Height="17"/>
                </Button>

            </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status / error text (hidden until needed) ── -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="" TextWrapping="Wrap"
                   IsVisible="False"
                   Height="0"/>

        <!-- Library and player occupy separate rows over one continuous artwork background. -->
        <Grid RowDefinitions="*,Auto">
            <Panel Grid.Row="0">

            <views:AudioSpectrumControl x:Name="SpectrumVisualizer"
                                        Height="140"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        IsHitTestVisible="False"/>

            <ListBox x:Name="FileList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="6,8">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackDisplayItem">
                        <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                            <Border Grid.Row="0"
                                    Classes="track-card"
                                    Tapped="OnTrackCardTapped"
                                    DoubleTapped="OnTrackCardDoubleTapped"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Padding="0,0">
                                <Panel>
                                <views:TrackColorWashControl
                                        PrimaryColor="{Binding ArtworkPrimaryColor}"
                                        SecondaryColor="{Binding ArtworkSecondaryColor}"
                                        Seed="{Binding Track.Id}"
                                        Strength="{Binding TrackColorWashStrength}"
                                        Reach="{Binding TrackColorWashReach}"
                                        Margin="-8,0"
                                        IsHitTestVisible="False">
                                    <views:TrackColorWashControl.Effect>
                                        <BlurEffect Radius="8"/>
                                    </views:TrackColorWashControl.Effect>
                                </views:TrackColorWashControl>
                                <Image Source="{Binding Thumbnail}"
                                       Width="106" Height="68"
                                       Margin="18,-10,0,-10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="UniformToFill"
                                       Opacity="{Binding TrackArtworkOpacity}"
                                       IsHitTestVisible="False">
                                    <Image.Effect>
                                        <BlurEffect Radius="{Binding TrackArtworkBlur}"/>
                                    </Image.Effect>
                                </Image>
                                <Border Background="{Binding PlayingBackground}"
                                        CornerRadius="7"
                                        IsHitTestVisible="False"/>
                                <Grid ColumnDefinitions="4,52,*">

                                    <Border Grid.Column="0"
                                            Classes="selection-accent"
                                            Width="2" Height="24"
                                            CornerRadius="2"
                                            Margin="0,8"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>

                                    <Border Grid.Column="0"
                                            Width="3" Height="34"
                                            CornerRadius="2"
                                            Margin="0,8"
                                            Background="{Binding PlayingAccent}"
                                            VerticalAlignment="Center"/>

                                    <!-- The local halo lets the cover bleed softly into its immediate surroundings. -->
                                    <Panel Grid.Column="1"
                                           Width="52" Height="52"
                                           VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}"
                                               Width="50" Height="50"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="UniformToFill"
                                               Opacity="{Binding CoverHaloOpacity}"
                                               IsHitTestVisible="False">
                                            <Image.Effect>
                                                <BlurEffect Radius="{Binding CoverHaloBlur}"/>
                                            </Image.Effect>
                                        </Image>
                                        <Border Width="42" Height="42"
                                                CornerRadius="8" ClipToBounds="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#292C25"
                                                BorderBrush="{Binding ArtworkBorderBrush}"
                                                BorderThickness="0.75"
                                                BoxShadow="0 2 8 0 #4D000000">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                    </Panel>

                                    <!-- Two-line hierarchy: track identity, then source and classification. -->
                                    <Grid Grid.Column="2"
                                          VerticalAlignment="Center"
                                          RowDefinitions="Auto,Auto"
                                          Margin="0,0,120,0"
                                          RowSpacing="4">
                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,Auto,*">
                                            <Border Background="{Binding RatingBackground}"
                                                    BorderBrush="{Binding RatingBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Opacity="0.7"
                                                    Width="55"
                                                    Height="18"
                                                    Padding="4,0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingText}"
                                                           FontFamily="Consolas"
                                                           FontSize="9.5"
                                                           FontStretch="ExtraExpanded"
                                                           LineHeight="18"
                                                           HorizontalAlignment="Stretch"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding RatingForeground}">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform Y="2"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Border>
                                            <Image Grid.Column="1"
                                                   Source="{SvgImage /Assets/public.svg}"
                                                   IsVisible="{Binding Track.IsPublic}"
                                                   Width="13" Height="13"
                                                   Margin="0,0,6,0"
                                                   Opacity="0.9"
                                                   ToolTip.Tip="Public track"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Track.Title}"
                                                   Foreground="{Binding TitleBrush}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding ChannelText}"
                                                       FontSize="10.5" Opacity="0.62"
                                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ChannelSeparatorText}"
                                                       FontSize="10.5" Opacity="0.38"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding GenreText}"
                                                       FontSize="11"
                                                       Foreground="{Binding ArtworkMetadataBrush}"
                                                       MaxWidth="610"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <views:TrackTagSummaryControl Tags="{Binding TagDisplays}"
                                                                          Grid.Column="3"
                                                                          Margin="12,0,8,0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center">
                                                <views:TrackTagSummaryControl.RenderTransform>
                                                    <TranslateTransform Y="1"/>
                                                </views:TrackTagSummaryControl.RenderTransform>
                                            </views:TrackTagSummaryControl>
                                        </Grid>
                                    </Grid>

                                </Grid>
                                <StackPanel Width="76"
                                            Margin="0,0,8,0"
                                            Spacing="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{Binding DownloadedDateText}"
                                               IsVisible="{Binding ShowDownloadedDate}"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DurationText}"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Foreground="#D7D0B8"
                                               Opacity="0.88"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </StackPanel>
                                <Button Classes="icon queue-menu"
                                        Width="28" Height="28"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="OnTrackPlaybackMenuClicked"
                                        ToolTip.Tip="Playback options">
                                    <TextBlock Text="⋮" FontSize="18" Margin="0,-2,0,0"/>
                                </Button>
                                </Panel>
                            </Border>
                            <Rectangle Grid.Row="1"
                                       Height="1"
                                       Margin="20,4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0%,50%"
                                                         EndPoint="100%,50%">
                                        <GradientStop Color="#003C3930" Offset="0"/>
                                        <GradientStop Color="#FF3C3930" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Panel>

            <!-- ── Player bar ── -->
            <Border x:Name="PlayerBar"
                    Grid.Row="1"
                    ZIndex="30"
                    Height="118"
                    Padding="0"
                    Background="Transparent"
                    ClipToBounds="False"
                    CornerRadius="0,0,0,0"
                    BorderThickness="0"
                    PointerPressed="OnPlayerBarPointerPressed"
                    BoxShadow="0 -14 36 6 #C0000000">
                <Border CornerRadius="0,0,0,0"
                        ClipToBounds="True">
                    <Panel>
                        <Image x:Name="PlayerArtworkPreviousBackground"
                               IsVisible="False"
                               IsHitTestVisible="False"
                               Height="118"
                               VerticalAlignment="Stretch"
                               Opacity="0"
                               Stretch="UniformToFill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.10" ScaleY="1.10"/>
                            </Image.RenderTransform>
                            <Image.Effect>
                                <BlurEffect Radius="30"/>
                            </Image.Effect>
                        </Image>
                        <Image x:Name="PlayerArtworkBackground"
                               IsVisible="False"
                               IsHitTestVisible="False"
                               Height="118"
                               VerticalAlignment="Stretch"
                               Opacity="0.52"
                               Stretch="UniformToFill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.10" ScaleY="1.10"/>
                            </Image.RenderTransform>
                            <Image.Effect>
                                <BlurEffect Radius="30"/>
                            </Image.Effect>
                        </Image>
                        <Border x:Name="PlayerDarkeningOverlay"
                                Background="#8E2A241A"
                                CornerRadius="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PlayerAtmosphereTint"
                                CornerRadius="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#30545FAF" Offset="0"/>
                                    <GradientStop Color="#24734FA8" Offset="0.58"/>
                                    <GradientStop Color="#08000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                    <GradientStop Color="#70000000" Offset="0"/>
                                    <GradientStop Color="#30000000" Offset="0.42"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="PlayerChromeEdge"
                                Height="1"
                                Margin="10,0"
                                CornerRadius="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="#4A756B54"
                                IsHitTestVisible="False"/>
                        <Border x:Name="PlayerTopGlow"
                                Height="0"
                                CornerRadius="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="#00000000"
                                IsHitTestVisible="False"/>
                        <Grid Margin="16,8,16,10"
                              RowDefinitions="22,28,*"
                              RowSpacing="3">

                            <Border x:Name="UpcomingBar"
                                    Grid.Row="0"
                                    IsVisible="False"
                                    Padding="4,0,4,0">
                                <DockPanel>
                                    <TextBlock x:Name="CrossfadeStatusText"
                                               DockPanel.Dock="Right"
                                               IsVisible="False"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Next:"
                                                   FontSize="11" Opacity="0.4"/>
                                        <TextBlock x:Name="UpcomingTrackText"
                                                   FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid x:Name="PlaybackInfoPanel"
                                  Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  Height="28"
                                  IsVisible="False">
                                <Border Grid.Column="0"
                                        ClipToBounds="False">
                                    <Slider x:Name="PlaybackSlider"
                                            Classes="playback"
                                            Minimum="0" Maximum="100" Value="0"
                                            Margin="0,-5,0,0"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="PlaybackTimeText"
                                           Grid.Column="1"
                                           Text="" FontSize="11" Opacity="0.55"
                                           Margin="10,0,0,0" MinWidth="86"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*,Auto"
                                  Height="42">

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Classes="icon"
                                            Click="OnPreviousClicked"
                                            ToolTip.Tip="Previous track">
                                        <Image Source="{SvgImage /Assets/skip-back.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                    <Button x:Name="PlayPauseBtn"
                                            Classes="icon"
                                            Click="OnPlayPauseClicked"
                                            ToolTip.Tip="Play / Pause">
                                        <Grid Width="26" Height="26">
                                            <Image x:Name="PlayIcon"
                                                   Source="{SvgImage /Assets/play.svg}"/>
                                            <Image x:Name="PauseIcon"
                                                   Source="{SvgImage /Assets/pause.svg}"
                                                   IsVisible="False"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="icon"
                                            Click="OnNextClicked"
                                            ToolTip.Tip="Next track">
                                        <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           x:Name="NowPlayingText"
                                           Text=""
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           Opacity="0.82"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,18,0"
                                           Padding="0,0,4,0"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <Border ClipToBounds="False">
                                        <Slider x:Name="VolumeSlider"
                                                Classes="playback"
                                                Minimum="0" Maximum="100" 
                                                Opacity="0.6"
                                                Value="100"
                                                Width="108"
                                                Height="28"
                                                Margin="0,-5,0,0"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="ShuffleBtn"
                                            Classes="icon"
                                            Click="OnShuffleToggleClicked"
                                            Opacity="0.35"
                                            ToolTip.Tip="Shuffle: Off">
                                        <Image Source="{SvgImage /Assets/shuffle.svg}"
                                               Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Panel>
                </Border>
            </Border>

            <!-- ── Filter workspace overlay ── -->
            <Border x:Name="FilterDrawer"
                    Grid.Row="0"
                    ZIndex="40"
                    IsVisible="False"
                    Background="Transparent"
                    BorderThickness="0"
                    ClipToBounds="True">
                <Border x:Name="FilterSurface"
                        Background="#F2121212"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#14FFFFFF">
                <Grid RowDefinitions="Auto,*" Margin="30,22,30,26">
                    <Rectangle x:Name="FilterAtmosphereTint"
                               Grid.RowSpan="2"
                               Margin="-30,-22,-30,-26"
                               Opacity="0.12"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="100%,100%" EndPoint="15%,10%">
                                <GradientStop Color="#D0545FAF" Offset="0"/>
                                <GradientStop Color="#90734FA8" Offset="0.48"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="✕"
                                Click="OnToggleFiltersClicked"
                                Classes="icon"
                                ToolTip.Tip="Close filters"
                                Opacity="0.7"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="280,49,*">
                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Presets"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="AddPresetButton"
                                                Classes="bare-add"
                                                Click="OnAddPresetClicked"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Create preset">
                                            <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="PresetRows" Spacing="7"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="SORT"
                                               FontSize="10" FontWeight="SemiBold"
                                               Opacity="0.42" LetterSpacing="1"/>
                                    <Border Background="{DynamicResource Theme.Brush.Surface}"
                                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="4">
                                        <Grid ColumnDefinitions="*,1,36">
                                            <ComboBox x:Name="SortByBox"
                                                      Grid.Column="0"
                                                      Height="30"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,3"
                                                      SelectionChanged="OnSortChanged"/>
                                            <Rectangle Grid.Column="1"
                                                       Fill="{DynamicResource Theme.Brush.BorderSubtle}"
                                                       Margin="2,5"/>
                                            <Button x:Name="SortDirectionButton"
                                                    Grid.Column="2"
                                                    Content="↑"
                                                    Click="OnSortDirectionClicked"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource Theme.Brush.Accent}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Padding="0"
                                                    ToolTip.Tip="Toggle sort direction"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                                        <TextBlock Text="RATING"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.42" LetterSpacing="1"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Width="140" Height="26"
                                                Background="{DynamicResource Theme.Brush.Surface}"
                                                BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                ClipToBounds="True">
                                            <Grid ColumnDefinitions="69,69">
                                                <Border x:Name="RatingModeIndicator"
                                                        Grid.ColumnSpan="2"
                                                        Width="69"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Theme.Brush.AccentSurface}"
                                                        CornerRadius="5,0,0,5"
                                                        IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform>
                                                            <TranslateTransform.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                                </Transitions>
                                                            </TranslateTransform.Transitions>
                                                        </TranslateTransform>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnAllRatingsPressed">
                                                    <TextBlock x:Name="AllRatingsText" Text="All"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnManualRatingsPressed">
                                                    <TextBlock x:Name="ManualRatingsText" Text="Manual"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="RatingButtonsPanel"
                                                IsVisible="False"
                                                Spacing="5"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="APPLIED SETS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Opacity="0.42"
                                               LetterSpacing="1"/>
                                    <StackPanel x:Name="FilterGroupsPanel" Spacing="8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{DynamicResource Theme.Brush.Divider}"/>

                        <DockPanel Grid.Column="2" LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Conditions" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel DockPanel.Dock="Top"
                                            Spacing="9"
                                            Margin="0,0,0,14">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                            <TextBlock Text="Current set"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                Width="106" Height="24"
                                                Background="Transparent"
                                                ClipToBounds="True">
                                            <Grid ColumnDefinitions="52,52">
                                                <Border x:Name="ConditionModeIndicator"
                                                        Grid.ColumnSpan="2"
                                                        Width="38"
                                                        Height="2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="7,0"
                                                        Background="{DynamicResource Theme.Brush.Success}"
                                                        CornerRadius="1"
                                                        IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform>
                                                            <TranslateTransform.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                                </Transitions>
                                                            </TranslateTransform.Transitions>
                                                        </TranslateTransform>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnIncludeConditionPressed">
                                                    <TextBlock x:Name="IncludeConditionText" Text="Include"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnExcludeConditionPressed">
                                                    <TextBlock x:Name="ExcludeConditionText" Text="Exclude"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            </Border>
                                            <Button x:Name="AddFilterGroupButton"
                                                    Grid.Column="2"
                                                    Click="OnAddFilterGroupClicked"
                                                    Width="26" Height="24"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    IsEnabled="False"
                                                    ToolTip.Tip="Add set">
                                                <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Rectangle Width="220" Height="1"
                                                   HorizontalAlignment="Left"
                                                   Fill="{DynamicResource Theme.Brush.Divider}"
                                                   Opacity="0.7"/>

                                        <TextBlock x:Name="CurrentSetEmptyText"
                                                   Text="Select genres, tags, languages or emotional character ranges below."
                                                   FontSize="10.5"
                                                   Opacity="0.5"/>
                                        <StackPanel x:Name="CurrentSetGenresRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="GENRES" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetGenresText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetTagsRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="TAGS" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetTagsText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetLanguagesRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="LANGUAGES" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetLanguagesText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetEmotionalRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="EMOTIONAL CHARACTER" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetEmotionalText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,14,0">
                                    <StackPanel x:Name="FilterBuilderPanel" Spacing="12"/>
                                </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
                </Border>
            </Border>

            <views:AddTrackOverlay x:Name="AddTrackOverlay" Grid.Row="0" IsVisible="False"/>

        </Grid>

    </DockPanel>

    <views:ChannelOverlay x:Name="ChannelOverlay" IsVisible="False" ZIndex="65"/>

    <!-- Queue management is a workspace, not a small dialog. It deliberately stops above the player. -->
    <views:ImportOverlay x:Name="ImportOverlay" IsVisible="False" ZIndex="70"/>

    <views:ActivityCenter x:Name="ActivityCenter"
                          IsVisible="False"
                          ZIndex="75"
                          Width="430"
                          MaxHeight="540"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,70,20,0"/>

    <!-- Covers the toolbar as well as the list while track details are open. -->
    <views:EditTrackOverlay x:Name="EditTrackOverlay" IsVisible="False" ZIndex="80"/>

    <views:SettingsOverlay x:Name="SettingsOverlay" IsVisible="False" ZIndex="90"/>

    <Border x:Name="DeleteTrackConfirmation"
            IsVisible="False"
            ZIndex="95"
            Background="#B8000000"
            Focusable="True"
            KeyDown="OnDeleteTrackConfirmationKeyDown">
        <Border Width="410"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Theme.Brush.Surface}"
                BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22"
                BoxShadow="0 14 38 4 #88000000">
            <StackPanel Spacing="14">
                <TextBlock Text="Delete track?"
                           FontSize="17"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="DeleteTrackConfirmationText"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="9"
                            Margin="0,5,0,0">
                    <Button x:Name="CancelTrackDeleteButton"
                            Content="Cancel"
                            MinWidth="88"
                            Click="OnCancelTrackDeleteClicked"/>
                    <Button Content="Delete"
                            MinWidth="88"
                            Background="{DynamicResource Theme.Brush.DangerSurface}"
                            BorderBrush="{DynamicResource Theme.Brush.DangerBorder}"
                            Click="OnConfirmTrackDeleteClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>


    <Border x:Name="Toast"
            IsVisible="False"
            ZIndex="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,104,0,0"
            Background="#E6101821"
            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,9"
            BoxShadow="0 8 24 2 #66000000">
        <TextBlock x:Name="ToastText"
                   FontSize="12"
                   Foreground="#EAF3FA"/>
    </Border>

    </Panel>

</UserControl>
