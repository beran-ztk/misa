<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Views.AddVersionOverlay"
             KeyDown="OnDialogKeyDown">
    <Panel>
        <Border Background="#85000000" />
        <Border x:Name="DialogCard" Width="380" Padding="22"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Theme.Brush.Surface}"
                BorderBrush="{DynamicResource Theme.Brush.BorderStrong}" BorderThickness="1"
                CornerRadius="10" BoxShadow="0 12 40 0 #80000000">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Add version" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Click="OnCloseClicked"
                            Background="Transparent" BorderThickness="0" Padding="6,2" ToolTip.Tip="Close" />
                </Grid>
                <TextBlock x:Name="OriginalTitleText" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="TypeStep" Spacing="14">
                    <TextBlock Text="Which version would you like to add?" FontSize="12" />
                    <ComboBox x:Name="TypeBox" PlaceholderText="Choose a type…" HorizontalAlignment="Stretch"
                              SelectionChanged="OnTypeChanged" />
                    <Button x:Name="NextButton" Content="Continue" Click="OnNextClicked" IsEnabled="False"
                            HorizontalAlignment="Right" Padding="16,7" />
                </StackPanel>
                <StackPanel x:Name="UrlStep" Spacing="12" IsVisible="False">
                    <TextBlock x:Name="SelectedTypeText" FontSize="12" FontWeight="SemiBold" Foreground="#B7DED6" />
                    <TextBox x:Name="UrlBox" Watermark="Paste YouTube URL…" TextChanged="OnUrlChanged" />
                    <TextBlock Text="Download and analysis continue in Add Tracks after this window closes."
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#ED9999" TextWrapping="Wrap" IsVisible="False" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Content="Back" Click="OnBackClicked" Padding="12,7" />
                        <Button x:Name="QueueButton" Grid.Column="2" Content="Add to queue" Click="OnQueueClicked"
                                IsEnabled="False" Padding="16,7" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
