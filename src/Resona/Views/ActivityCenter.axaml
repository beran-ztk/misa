<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Views.ActivityCenter">
    <UserControl.Styles>
        <Style Selector="Button.activity-action">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.activity-action:pointerover">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#FA1C1C1E"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 12 36 4 #88000000"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="3" Margin="16,12,10,10">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Activity Center" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LimitText" Text="YouTube · 0/3 active" FontSize="9.5"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </StackPanel>
                <Button x:Name="PauseBackgroundButton" Grid.Column="1"
                        Classes="activity-action"
                        Click="OnPauseBackgroundClicked" ToolTip.Tip="Pause background YouTube jobs">
                    <Grid>
                        <Image x:Name="PauseBackgroundIcon" Source="{SvgImage /Assets/pause.svg}" Width="14" Height="14" Opacity="0.8"/>
                        <Image x:Name="ResumeBackgroundIcon" Source="{SvgImage /Assets/play.svg}" Width="14" Height="14" Opacity="0.8" IsVisible="False"/>
                    </Grid>
                </Button>
                <Button x:Name="ClearHistoryButton" Grid.Column="2"
                        Classes="activity-action"
                        Click="OnClearHistoryClicked" ToolTip.Tip="Clear finished jobs">
                    <Image Source="{SvgImage /Assets/trash.svg}" Width="14" Height="14" Opacity="0.72"/>
                </Button>
                <Button Grid.Column="3" Classes="activity-action" Opacity="0.72"
                        Click="OnCloseClicked" ToolTip.Tip="Close Activity Center">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="15" Height="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#0EFFFFFF" BorderBrush="#20FFFFFF"
                    BorderThickness="0,1" Padding="16,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock x:Name="SummaryText" Text="No YouTube activity" FontSize="10.5"
                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                    <TextBlock x:Name="PausedText" Grid.Column="1" Text="BACKGROUND PAUSED"
                               IsVisible="False" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.Warning}" LetterSpacing="0.6"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" MaxHeight="440" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,11,10,14" Spacing="7">
                    <TextBlock x:Name="EmptyText" Text="Nothing has run in this session yet."
                               Margin="0,4" FontSize="11" Opacity="0.5"/>
                    <StackPanel x:Name="JobRows" Spacing="6"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
