<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.KnownIssuesPanel">
    <UserControl.Styles>
        <Style Selector="Button.issue-action">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.issue-action:pointerover">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="Border.issue-row:pointerover">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#FA1C1C1E" BorderBrush="#32FFFFFF" BorderThickness="1"
            CornerRadius="10" BoxShadow="0 12 36 4 #88000000" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="3" Margin="16,12,10,10">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Known Issues" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UpdatedText" Text="Loading GitHub issues…" FontSize="9.5"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="issue-action" Click="OnRefreshClicked" ToolTip.Tip="Refresh issues">
                    <Image Source="{SvgImage /Assets/reload.svg}" Width="14" Height="14" Opacity="0.78"/>
                </Button>
                <Button Grid.Column="2" Classes="issue-action" Click="OnCloseClicked" ToolTip.Tip="Close known issues" Opacity="0.72">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="15" Height="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#0EFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,1" Padding="16,8">
                <TextBlock x:Name="SummaryText" Text="No open issues" FontSize="10.5"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="IssueRows" Margin="14,11,10,14" Spacing="6"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="EmptyTitleText" Text="No open issues" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyDescriptionText" Text="GitHub issues will appear here." FontSize="10" Opacity="0.5"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
