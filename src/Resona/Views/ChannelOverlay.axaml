<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Resona.Models"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.ChannelOverlay"
             Background="#F2121212">
    <UserControl.Resources>
        <DataTemplate x:Key="ChannelCardTemplate" x:DataType="models:ChannelHubItem">
            <Border Classes="channel-card" Width="370"
                    MinHeight="140"
                    Margin="0,0,10,10"
                    Padding="14,12"
                    Background="#10FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    Tapped="OnChannelCardTapped">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="#243E6591"
                                BorderBrush="#486E91BA" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" IsVisible="{Binding HasArtwork}"/>
                            <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#DCEBFA"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="245"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding TrackCountText}" FontSize="10.5" Opacity="0.58"/>
                                <TextBlock Text="·" FontSize="10.5" Opacity="0.36"
                                           IsVisible="{Binding HasNewVideos}"/>
                                <TextBlock Text="{Binding NewVideoText}" FontSize="10.5" Opacity="0.58"
                                           IsVisible="{Binding HasNewVideos}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AudienceText}" FontSize="9.5" Opacity="0.46"
                                       TextTrimming="CharacterEllipsis" MaxWidth="250"
                                       ToolTip.Tip="{Binding AudienceText}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="follow-toggle" Classes.following="{Binding IsFollowed}"
                                Content="{Binding FollowGlyph}" Click="OnFollowChannelClicked"
                                ToolTip.Tip="{Binding FollowToolTip}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="1">
                            <TextBlock Text="QUALITY" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock Text="{Binding QualitySummaryText}" FontSize="10.5"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RatingText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="ACTIVITY" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock Text="{Binding ActivityText}" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding TopTracksText}"
                               IsVisible="{Binding HasTopTracks}"
                               FontSize="10" Opacity="0.58" TextWrapping="NoWrap"
                               LineHeight="15" MinHeight="45" MaxHeight="45"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChannelRowTemplate" x:DataType="models:ChannelHubItem">
            <Border Classes="channel-card" MinHeight="66" Padding="13,10" Margin="0,0,0,7" CornerRadius="8"
                    Background="#0EFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    Cursor="Hand" Tapped="OnChannelCardTapped">
                <Grid ColumnDefinitions="42,*,190,150,112" ColumnSpacing="14">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#213E6591"
                            BorderBrush="#356E91BA" BorderThickness="1" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" IsVisible="{Binding HasArtwork}"/>
                        <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#CBE1F4"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                        <TextBlock Text="YouTube channel" FontSize="9.5" Opacity="0.4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="VIDEOS" FontSize="8.5" FontWeight="SemiBold"
                                   LetterSpacing="0.8" Opacity="0.42"/>
                        <TextBlock Text="{Binding LibraryVideoSummaryText}" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="#D8E4EE"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="AVERAGE RATING" FontSize="8.5" FontWeight="SemiBold"
                                   LetterSpacing="0.75" Opacity="0.42"/>
                        <TextBlock Text="{Binding AverageRatingScaleText}" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="#E4C36D"/>
                        <ProgressBar Minimum="0" Maximum="6" Value="{Binding AverageRatingScore}"
                                     Width="112" Height="3" Margin="0,1,0,0"
                                     HorizontalAlignment="Left"
                                     Foreground="#DDBA5F" Background="#24FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="4"
                            Classes="channel-subscribe"
                            Classes.following="{Binding IsFollowed}"
                            Content="{Binding SubscribeActionText}"
                            Click="OnFollowChannelClicked"
                            ToolTip.Tip="{Binding SubscribeToolTip}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.channel-icon">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.channel-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Button.channel-icon.active">
            <Setter Property="Background" Value="#343C7FC4"/>
            <Setter Property="BorderBrush" Value="#805B9CDC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.hub-tab">
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.48"/>
        </Style>
        <Style Selector="Button.hub-tab:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Button.hub-tab.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.channel-title">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.channel-title:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent}"/>
        </Style>
        <Style Selector="Button.follow-action">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.follow-action:pointerover">
            <Setter Property="Background" Value="#293E6591"/>
        </Style>
        <Style Selector="Button.follow-action.following">
            <Setter Property="Background" Value="#343C7FC4"/>
            <Setter Property="BorderBrush" Value="#805B9CDC"/>
            <Setter Property="Foreground" Value="#E5F2FF"/>
        </Style>
        <Style Selector="Button.follow-toggle">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C9DFF2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.follow-toggle:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style Selector="Button.follow-toggle.following">
            <Setter Property="Foreground" Value="#D99B9B"/>
        </Style>
        <Style Selector="Button.channel-subscribe">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#183E6591"/>
            <Setter Property="BorderBrush" Value="#566F94B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Foreground" Value="#DCEBFA"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.channel-subscribe:pointerover">
            <Setter Property="Background" Value="#303E6591"/>
            <Setter Property="BorderBrush" Value="#8B80A9CF"/>
        </Style>
        <Style Selector="Button.channel-subscribe.following">
            <Setter Property="Background" Value="#173C7255"/>
            <Setter Property="BorderBrush" Value="#577EB391"/>
            <Setter Property="Foreground" Value="#CBE8D4"/>
        </Style>
        <Style Selector="Border.channel-card:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
        </Style>
        <Style Selector="Button.channel-sort">
            <Setter Property="Width" Value="188"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.channel-sort:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.channel-sort:pressed">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#725F86AD"/>
        </Style>
        <Style Selector="Button.sort-option">
            <Setter Property="Width" Value="208"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sort-option:pointerover">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.sort-option.selected">
            <Setter Property="Background" Value="#263E6591"/>
            <Setter Property="Foreground" Value="#E7F1FB"/>
        </Style>
        <Style Selector="Button.open-action">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
        </Style>
        <Style Selector="Button.open-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.video-filter">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.video-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.video-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.channel-hub-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.channel-hub-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0CFFFFFF"/>
        </Style>
        <Style Selector="ListBox.channel-hub-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
    <Grid>
        <Rectangle x:Name="ChannelAtmosphereTint" Opacity="0.12" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="100%,100%" EndPoint="15%,10%">
                    <GradientStop Color="#D0545FAF" Offset="0"/>
                    <GradientStop Color="#90734FA8" Offset="0.48"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="HubView" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="26,15">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="hub-tab active" Content="Channels"/>
                            <Button Classes="hub-tab" Content="Profiles" Click="OnProfilesTabClicked"/>
                        </StackPanel>
                        <StackPanel x:Name="HubBackgroundStatusPanel" IsVisible="False" Spacing="2" Margin="0,5,0,0">
                            <TextBlock x:Name="HubBackgroundOverallText" FontSize="10.5"
                                       Foreground="#BCD9EF"/>
                            <TextBlock x:Name="HubBackgroundCurrentText" FontSize="9.5" Opacity="0.52"
                                       HorizontalAlignment="Left" TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="HubBackgroundProgress" Height="2" Width="260"
                                         HorizontalAlignment="Left" Minimum="0" Maximum="1"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBox x:Name="ChannelSearchBox" Classes="compact-search"
                                 Width="230" Height="32" Watermark="Search channels…"
                                 IsVisible="False" VerticalContentAlignment="Center"
                                 TextChanged="OnChannelSearchChanged" KeyDown="OnChannelSearchKeyDown"
                                 LostFocus="OnChannelSearchLostFocus"/>
                        <Button x:Name="ChannelSearchToggleButton" Classes="channel-icon"
                                Click="OnChannelSearchToggleClicked" ToolTip.Tip="Search channels" Opacity="0.86">
                            <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button Classes="channel-icon" Click="OnAddChannelToggleClicked" ToolTip.Tip="Add channel">
                            <TextBlock Text="+" FontSize="20" Margin="0,-3,0,0"/>
                        </Button>
                        <Button Classes="channel-icon" Click="OnInboxClicked" ToolTip.Tip="Channel inbox">
                            <Grid>
                            <Image Source="{SvgImage /Assets/inbox.svg}" Width="17" Height="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="InboxBadge" IsVisible="False" Background="#D85D738D"
                                        CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0">
                                    <TextBlock x:Name="InboxBadgeText" FontSize="8" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*"
                  Margin="26,16,26,22" RowSpacing="16">
                    <Border x:Name="AddChannelPanel" Grid.Row="0" IsVisible="False"
                            Background="#10FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="14,11">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Text="ADD CHANNEL" FontSize="9.5" FontWeight="SemiBold"
                                       LetterSpacing="0.9" Opacity="0.48" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="UrlBox" Classes="compact-search"
                                     Height="30" Watermark="Paste YouTube channel URL…"
                                     TextChanged="OnUrlTextChanged" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StatusText" FontSize="10.5" Opacity="0.58"
                                       VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="FollowingSection" Grid.Row="1" Spacing="8">
                        <TextBlock x:Name="FollowingHeadingText" Text="FOLLOWING"
                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.52"/>
                        <TextBlock x:Name="EmptyFollowingText" Text="No followed channels yet. Add one or choose from your library below."
                                   FontSize="11" Opacity="0.48"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FollowingItems" ItemTemplate="{StaticResource ChannelCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="7" MinHeight="150">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="AllChannelsHeadingText"
                                       Text="You currently have 0 channels in your library."
                                       FontSize="11" Opacity="0.58" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="ChannelSortButton" Classes="channel-sort">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Flyout.FlyoutPresenterTheme>
                                            <ControlTheme TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </ControlTheme>
                                        </Flyout.FlyoutPresenterTheme>
                                        <Border Width="224" Padding="8" Background="#FC191A1D"
                                                BorderBrush="#3EFFFFFF" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="SORT CHANNELS BY"
                                                           Margin="10,5,10,7"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           LetterSpacing="0.8" Opacity="0.42"/>
                                                <Button x:Name="ChannelSortNameOption" Classes="sort-option selected"
                                                        Tag="0" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortNameCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0.9"/>
                                                        <TextBlock Grid.Column="1" Text="Name" FontSize="11.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ChannelSortRatingOption" Classes="sort-option"
                                                        Tag="1" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortRatingCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0"/>
                                                        <TextBlock Grid.Column="1" Text="Best rated" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ChannelSortLibraryOption" Classes="sort-option"
                                                        Tag="2" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortLibraryCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0"/>
                                                        <TextBlock Grid.Column="1" Text="Most library tracks" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ChannelSortVideosOption" Classes="sort-option"
                                                        Tag="3" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortVideosCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0"/>
                                                        <TextBlock Grid.Column="1" Text="Most channel videos" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ChannelSortRecentOption" Classes="sort-option"
                                                        Tag="4" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortRecentCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0"/>
                                                        <TextBlock Grid.Column="1" Text="Recently added" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ChannelSortPlayedOption" Classes="sort-option"
                                                        Tag="5" Click="OnChannelSortOptionClicked">
                                                    <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                        <Image x:Name="ChannelSortPlayedCheck" Source="{SvgImage /Assets/check.svg}"
                                                               Width="12" Height="12" Opacity="0"/>
                                                        <TextBlock Grid.Column="1" Text="Most played" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid ColumnDefinitions="*,14" ColumnSpacing="10">
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="SORT BY" FontSize="8" FontWeight="SemiBold"
                                                   LetterSpacing="0.65" Opacity="0.42"/>
                                        <TextBlock x:Name="ChannelSortText" Text="Name" FontSize="11.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Path Grid.Column="1" Width="10" Height="6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 1 1 L 5 5 L 9 1"
                                          Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                          StrokeThickness="1.5" StrokeLineCap="Round"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Padding="0,7,0,0">
                            <ListBox x:Name="AllChannelItems" Classes="channel-hub-list"
                                     Padding="0,0,14,0"
                                     ItemTemplate="{StaticResource ChannelRowTemplate}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"/>
                        </Border>
                        <TextBlock x:Name="EmptySearchText" Text="No channels match this search."
                                   Grid.Row="1" IsVisible="False" FontSize="11" Opacity="0.5" Margin="0,10,0,0"/>
                    </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ProfileHubView" IsVisible="False" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="26,15">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="hub-tab" Content="Channels" Click="OnChannelsTabClicked"/>
                        <Button Classes="hub-tab active" Content="Profiles"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBox x:Name="ProfileSearchBox" Classes="compact-search"
                                 Width="230" Height="32" Watermark="Search profiles…"
                                 VerticalContentAlignment="Center" TextChanged="OnProfileSearchChanged"/>
                        <Button Classes="channel-icon" Click="OnRefreshProfilesClicked" ToolTip.Tip="Refresh profiles">
                            <Image Source="{SvgImage /Assets/reload.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,16,26,22">
                <ListBox x:Name="ProfileList" Classes="channel-hub-list"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:CloudProfileDisplay">
                            <Border Classes="channel-card" Padding="13,11" Margin="0,0,0,7"
                                    Background="#0EFFFFFF" BorderBrush="#22FFFFFF"
                                    BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                    Tapped="OnCloudProfileTapped">
                                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="13">
                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="#243E6591" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasAvatar}"/>
                                            <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BioText}" FontSize="10.5" Opacity="0.58"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SynchronizedText}" FontSize="9.5" Opacity="0.4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{Binding TrackCountText}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="public tracks" FontSize="9" Opacity="0.42"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ProfileHubEmptyPanel" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="ProfileHubEmptyTitle" Text="No profiles found"
                               FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ProfileHubEmptyDescription" FontSize="10.5" Opacity="0.48"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ProfileDetailView" IsVisible="False" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="22,13">
                <Grid ColumnDefinitions="Auto,46,*,Auto" ColumnSpacing="11">
                    <Button Classes="channel-icon" Click="OnBackToProfilesClicked" ToolTip.Tip="Back to profiles">
                        <TextBlock Text="‹" FontSize="23" Margin="0,-4,0,0"/>
                    </Button>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                            Background="#243E6591" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ProfileDetailAvatar" Stretch="UniformToFill" IsVisible="False"/>
                            <TextBlock x:Name="ProfileDetailMonogram" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileDetailName" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProfileDetailBio" FontSize="10.5" Opacity="0.56"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBox x:Name="ProfileTrackSearchBox" Classes="compact-search"
                                 Width="230" Height="30" Watermark="Search tracks…"
                                 VerticalContentAlignment="Center" TextChanged="OnProfileTrackSearchChanged"/>
                        <Button Classes="channel-icon" Click="OnRefreshProfileTracksClicked" ToolTip.Tip="Refresh profile">
                            <Image Source="{SvgImage /Assets/reload.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="22,15,22,22" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ProfileTrackSummaryText" FontSize="10.5" Opacity="0.56"/>
                    <TextBlock Grid.Column="1" Text="Cloud data is shown as shared · downloads use your normal local pipeline"
                               FontSize="9.5" Opacity="0.38"/>
                </Grid>
                <ListBox x:Name="ProfileTrackList" Grid.Row="1" Classes="video-list"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:CloudProfileTrackDisplay">
                            <Border Padding="8,7" Margin="0,0,0,2" Background="Transparent"
                                    BorderBrush="#16FFFFFF" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="45,*,150,95,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding DurationText}" FontSize="10" Opacity="0.5"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OriginalTitle}"/>
                                        <TextBlock Text="{Binding ChannelText}" FontSize="9.5" Opacity="0.48"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ClassificationText}" FontSize="9.5" Opacity="0.58"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClassificationText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="SHARED ANALYSIS" FontSize="8" LetterSpacing="0.7" Opacity="0.36"/>
                                        <TextBlock Text="{Binding AnalysisText}" FontSize="9.5" Opacity="0.62"
                                                   TextWrapping="Wrap" MaxHeight="34" ToolTip.Tip="{Binding AnalysisText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OwnerRatingText}" FontSize="10" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LocalStatusText}" FontSize="9.5"
                                                   Foreground="{Binding LocalStatusBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3">
                                        <Button Classes="channel-icon"
                                                Click="OnProfileTrackDownloadClicked"
                                                IsVisible="{Binding CanDownload}"
                                                ToolTip.Tip="Download through YouTube">
                                            <Image Source="{SvgImage /Assets/download.svg}" Width="15" Height="15"/>
                                        </Button>
                                        <Button Classes="channel-icon"
                                                Click="OnProfileTrackReviewClicked"
                                                IsVisible="{Binding CanReview}"
                                                ToolTip.Tip="Rate and accept or decline">
                                            <Image Source="{SvgImage /Assets/check.svg}" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ProfileTrackEmptyPanel" Grid.Row="1" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="ProfileTrackEmptyTitle" Text="No public tracks"
                               FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ProfileTrackEmptyDescription" FontSize="10.5" Opacity="0.48"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="DetailView" IsVisible="False" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="22,13">
                <Grid ColumnDefinitions="Auto,42,*,Auto" ColumnSpacing="10">
                    <Button Classes="channel-icon" Click="OnBackToHubClicked" ToolTip.Tip="Back to channels">
                        <TextBlock Text="‹" FontSize="23" Margin="0,-4,0,0"/>
                    </Button>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#243E6591" ClipToBounds="True">
                        <Grid>
                        <Image x:Name="DetailChannelArtwork" Stretch="UniformToFill" IsVisible="False"/>
                        <TextBlock x:Name="DetailMonogramText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#DCEBFA"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedChannelText" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailSubtitleText" FontSize="10.5" Opacity="0.56"/>
                        <StackPanel x:Name="DetailBackgroundStatusPanel" IsVisible="False" Spacing="1" Margin="0,3,0,0">
                            <TextBlock x:Name="DetailBackgroundOverallText" FontSize="10"
                                       Foreground="#BCD9EF"/>
                            <TextBlock x:Name="DetailBackgroundCurrentText" FontSize="9" Opacity="0.5"
                                       HorizontalAlignment="Left" TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="DetailBackgroundProgress" Height="2" Width="230"
                                         HorizontalAlignment="Left" Minimum="0" Maximum="1"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBox x:Name="VideoSearchBox" Classes="compact-search"
                                 Width="210" Height="30" Watermark="Search videos…" IsVisible="False"
                                 VerticalContentAlignment="Center" TextChanged="OnVideoSearchChanged"
                                 KeyDown="OnVideoSearchKeyDown" LostFocus="OnVideoSearchLostFocus"/>
                        <Button x:Name="VideoSearchToggleButton" Classes="channel-icon"
                                Click="OnVideoSearchToggleClicked" ToolTip.Tip="Search videos" Opacity="0.86">
                            <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button x:Name="DetailFollowButton" Classes="follow-toggle" Click="OnDetailFollowClicked"/>
                        <Button x:Name="DetailAutoDownloadButton" Classes="channel-icon"
                                Click="OnDetailAutoDownloadClicked" ToolTip.Tip="Toggle automatic downloads">
                            <Image Source="{SvgImage /Assets/download.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="DetailRefreshButton" Classes="channel-icon" Click="OnRefreshSelectedClicked" ToolTip.Tip="Refresh channel">
                            <Image Source="{SvgImage /Assets/reload.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="22,16,22,22" RowSpacing="12">
                <Border Background="#0CFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <Grid ColumnDefinitions="0.85*,1.15*,1*,1.55*" ColumnSpacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIBRARY" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock x:Name="DetailLibraryText" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="QUALITY" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock x:Name="DetailRatingText" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="LISTENING" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock x:Name="DetailActivityText" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="TOP IN YOUR LIBRARY" FontSize="8.5" LetterSpacing="0.8" Opacity="0.42"/>
                            <TextBlock x:Name="DetailTopTracksText" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="VIDEOS" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.9"
                                   Opacity="0.48" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="channel-icon" Width="24" Height="24"
                                Click="OnRetryMetadataIssuesClicked" ToolTip.Tip="Retry failed metadata for this channel">
                            <Image Source="{SvgImage /Assets/reload.svg}" Width="12" Height="12"/>
                        </Button>
                        <TextBlock Grid.Column="2" x:Name="VideoSummaryText" IsVisible="False"/>
                        <TextBlock Grid.Column="3" x:Name="DetailRefreshStatusText" IsVisible="False"
                                   FontSize="10" Foreground="#AFCDE6" VerticalAlignment="Center"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                        <Button x:Name="AllVideosFilterButton" Classes="video-filter" Click="OnAllVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="All"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="AllVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="NewVideosFilterButton" Classes="video-filter" Click="OnNewVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="New"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="NewVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="MetadataVideosFilterButton" Classes="video-filter" Click="OnMetadataVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Metadata"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="MetadataVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="ReadyVideosFilterButton" Classes="video-filter" Click="OnReadyVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Ready"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="ReadyVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" x:Name="LibraryVideosFilterButton" Classes="video-filter" Click="OnLibraryVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="In library"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="LibraryVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" x:Name="RejectedVideosFilterButton" Classes="video-filter" Click="OnRejectedVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Rejected"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="RejectedVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" x:Name="IssueVideosFilterButton" Classes="video-filter" Click="OnIssueVideosFilterClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Issues"/>
                                <Border Background="#18FFFFFF" CornerRadius="8" Padding="5,1">
                                    <TextBlock x:Name="IssueVideosCountText" FontSize="8.5" Opacity="0.72"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Channel max" FontSize="9.5" Opacity="0.52" VerticalAlignment="Center"/>
                            <TextBox x:Name="ChannelMaxDurationBox" Classes="compact-search"
                                     Width="42" Height="26" FontSize="10" TextAlignment="Center"
                                     Watermark="global" VerticalContentAlignment="Center"
                                     LostFocus="OnChannelMaxDurationLostFocus"/>
                            <TextBlock Text="min" FontSize="9.5" Opacity="0.52" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="AutomationHintText" HorizontalAlignment="Right"
                               FontSize="9.5" Opacity="0.42"/>
                </Grid>

                <ListBox Grid.Row="2" x:Name="VideoList" Classes="video-list"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:ChannelVideoDisplay">
                            <Border Background="{Binding Background}" Opacity="{Binding Opacity}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                                    CornerRadius="6" Padding="10,7" Margin="0,0,0,2"
                                    Tapped="OnVideoRowTapped">
                                <Grid ColumnDefinitions="*,132,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextDecorations="{Binding TextDecorations}"
                                                   Foreground="{Binding TitleBrush}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MetadataSummaryText}" FontSize="9.5" Opacity="0.44"
                                                   IsVisible="{Binding HasMetadataSummary}"/>
                                        <TextBlock Text="{Binding MetadataErrorSummary}" IsVisible="{Binding HasMetadataError}"
                                                   ToolTip.Tip="{Binding MetadataErrorDetails}" FontSize="10.5"
                                                   Foreground="#E87878" Opacity="0.86" TextWrapping="Wrap" MaxHeight="34"/>
                                        <TextBlock Text="{Binding DownloadErrorSummary}" IsVisible="{Binding HasDownloadError}"
                                                   ToolTip.Tip="{Binding DownloadErrorDetails}" FontSize="10.5"
                                                   Foreground="#E87878" Opacity="0.86" TextWrapping="Wrap" MaxHeight="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.62"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
                                        <TextBlock Text="{Binding LibraryDetailsText}" FontSize="9" Opacity="0.45"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LibraryDetailsText}"
                                                   IsVisible="{Binding HasLibraryDetails}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button Classes="channel-icon" Click="OnVideoDownloadClicked"
                                                IsVisible="{Binding CanDownload}" ToolTip.Tip="Download this track">
                                            <Image Source="{SvgImage /Assets/download.svg}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Classes="channel-icon" Click="OnVideoRetryIssueClicked"
                                                IsVisible="{Binding CanRetryError}" ToolTip.Tip="{Binding RetryErrorToolTip}">
                                            <Image Source="{SvgImage /Assets/reload.svg}" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="3" Classes="channel-icon" Click="OnVideoPlayClicked" IsVisible="{Binding CanPlay}"
                                            ToolTip.Tip="Play downloaded audio" Opacity="{Binding ActionOpacity}">
                                        <Image Source="{SvgImage /Assets/play.svg}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Grid.Column="4" Classes="channel-icon" Click="OnVideoCheckClicked" IsVisible="{Binding CanReview}"
                                            ToolTip.Tip="Rate and add to library" Opacity="{Binding ActionOpacity}">
                                        <Image Source="{SvgImage /Assets/check.svg}" Width="15" Height="15"/>
                                    </Button>
                                    <Button Grid.Column="5" Classes="channel-icon" Click="OnVideoSkipClicked" IsVisible="{Binding CanDismiss}"
                                            ToolTip.Tip="{Binding DismissToolTip}" Opacity="{Binding ActionOpacity}">
                                        <Image Source="{SvgImage /Assets/close.svg}" Width="14" Height="14"/>
                                    </Button>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                        <Button Classes="channel-icon" Click="OnCopyVideoUrlClicked" ToolTip.Tip="Copy video URL" Opacity="0.65">
                                            <Image Source="{SvgImage /Assets/copy.svg}" Width="14" Height="14"/>
                                        </Button>
                                        <TextBlock Text="{Binding DurationText}" FontSize="10.5" Opacity="0.62"
                                                   MinWidth="38" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" x:Name="EmptyVideoPanel" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="EmptyVideoTitleText" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyVideoDescriptionText" FontSize="10.5" Opacity="0.48"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="InboxView" IsVisible="False" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="22,13">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Classes="channel-icon" Click="OnBackFromInboxClicked" ToolTip.Tip="Back to channels">
                        <TextBlock Text="‹" FontSize="23" Margin="0,-4,0,0"/>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Channel inbox" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InboxSummaryText" FontSize="10.5" Opacity="0.56"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="channel-icon" Click="OnCloseClicked" ToolTip.Tip="Close" Opacity="0.72">
                        <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="26,16,26,22">
                <ListBox x:Name="InboxItems" Classes="channel-hub-list"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ChannelNotification">
                            <Border Padding="11,9" Margin="0,0,0,2" CornerRadius="6"
                                    Background="#0CFFFFFF">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="11">
                                    <Border Width="7" Height="7" CornerRadius="4" Background="#82B8E4"
                                            IsVisible="{Binding !IsRead}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChannelName}" FontSize="9.5" Opacity="0.5"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CreatedText}" FontSize="9.5" Opacity="0.42"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="channel-icon" Click="OnOpenNotificationClicked" ToolTip.Tip="Open channel">
                                        <TextBlock Text="›" FontSize="19" Margin="0,-2,0,0"/>
                                    </Button>
                                    <Button Grid.Column="3" Classes="channel-icon" Click="OnArchiveNotificationClicked"
                                            ToolTip.Tip="Remove from inbox" Opacity="0.65">
                                        <Image Source="{SvgImage /Assets/close.svg}" Width="13" Height="13"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyInboxText" Text="You're all caught up."
                           IsVisible="False" FontSize="11.5" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</UserControl>
