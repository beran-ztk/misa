<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Views.MultiSelectFilterControl">
    <Button x:Name="ToggleBtn"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{DynamicResource Theme.Brush.Surface}"
            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="6,6,0,0"
            Margin="0"
            Padding="10,7">
        <Button.Flyout>
            <Flyout Placement="Bottom">
                <Flyout.FlyoutPresenterTheme>
                    <ControlTheme TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
                    </ControlTheme>
                </Flyout.FlyoutPresenterTheme>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
