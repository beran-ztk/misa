<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Misa.Views.DownloadWindow"
        Title="Add Track"
        Width="880" Height="640"
        MinWidth="600" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <!-- Body -->
        <ScrollViewer Padding="24,18,24,0"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="22" Margin="0,0,0,20">

                <!-- Source -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Source"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="YouTube URL"
                               FontSize="12" Opacity="0.6" />
                    <TextBox x:Name="UrlBox"
                             Watermark="https://www.youtube.com/watch?v=…" />
                    <TextBlock Text="Title (optional)"
                               FontSize="12" Opacity="0.6"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="TitleBox"
                             Watermark="Derived from filename if left empty" />
                </StackPanel>

                <!-- Rating -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Rating"
                               FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="RatingBox" MinWidth="200" />
                </StackPanel>

                <!-- Genres -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Genres"
                               FontSize="13" FontWeight="SemiBold" />
                    <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                </StackPanel>

                <!-- Styles -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Styles"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="optional"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                    <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                </StackPanel>

                <!-- Languages -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Languages"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="optional"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                    <WrapPanel x:Name="LanguagesPanel" Orientation="Horizontal" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        
        <Border Padding="24,10,24,16"
                BorderThickness="0,1,0,0" BorderBrush="#18808080">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="" TextWrapping="Wrap"
                           FontSize="12" Opacity="0.65"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DownloadBtn"
                            Content="Download"
                            Click="OnDownloadClicked"
                            IsEnabled="False"
                            Classes="accent" />
                    <Button x:Name="CloseBtn"
                            Content="Cancel"
                            Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>

</Window>
