<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Misa.Views.AddTrackOverlay">

    <Panel>

        <!-- Dim backdrop -->
        <Border Background="#70000000" />

        <!-- Modal card: stretches to fill the panel with margin so footer is always in view -->
        <Border Margin="32,16,32,16"
                MaxWidth="880" MinWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#1E1E1E"
                CornerRadius="8"
                BoxShadow="0 8 40 4 #80000000">

            <Grid RowDefinitions="Auto,1,*,1,Auto">

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="24,16,20,14">
                    <TextBlock Grid.Column="0"
                               Text="Add Track"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="OnCloseClicked"
                            Padding="8,4" FontSize="13"
                            Opacity="0.55"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Header/body divider -->
                <Rectangle Grid.Row="1" Fill="#18808080" />

                <!-- Body (scrollable) -->
                <ScrollViewer Grid.Row="2"
                              Padding="24,18,24,0"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="22" Margin="0,0,0,20">

                        <!-- Source -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Source"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="YouTube URL"
                                       FontSize="12" Opacity="0.6" />
                            <TextBox x:Name="UrlBox"
                                     Watermark="https://www.youtube.com/watch?v=…" />
                            <TextBlock Text="Title (optional)"
                                       FontSize="12" Opacity="0.6"
                                       Margin="0,8,0,0" />
                            <TextBox x:Name="TitleBox"
                                     Watermark="Derived from filename if left empty" />
                        </StackPanel>

                        <!-- Rating -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Rating"
                                       FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="RatingBox" MinWidth="200" />
                        </StackPanel>
                        
                        <!-- Genres -->
                        <StackPanel Spacing="8" Margin="0,0,40,0">
                            <TextBlock Text="Genres"
                                       FontSize="13" FontWeight="SemiBold" />
                            <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                            <Button x:Name="ShowMoreGenresBtn"
                                    Content="Show more genres"
                                    IsVisible="False"
                                    Click="OnShowMoreGenresClicked"
                                    Padding="8,4" FontSize="11"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Styles: shown only after at least one genre is selected.
                             The left accent bar visually anchors styles under their genre context. -->
                        <Grid x:Name="StylesSection" IsVisible="False"
                              ColumnDefinitions="Auto,*" Margin="0,0,40,0">
                            <Border Grid.Column="0"
                                    Width="2" Margin="0,2,0,2"
                                    Background="#40808080" CornerRadius="1" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Styles"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="optional"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Grid>
                        <!-- Languages -->
                        <StackPanel Spacing="8" Margin="0,0,40,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Language"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="optional"
                                           FontSize="11" Opacity="0.4"
                                           VerticalAlignment="Bottom" Margin="0,0,0,1" />
                            </StackPanel>
                            <WrapPanel x:Name="LanguagesPanel" Orientation="Horizontal" />
                        </StackPanel>
                        
                        <Border Height="10" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Body/footer divider -->
                <Rectangle Grid.Row="3" Fill="#18808080" />

                <!-- Footer -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*,Auto"
                      Margin="24,10,24,16">
                    <TextBlock Grid.Column="0"
                               x:Name="StatusText"
                               Text="" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.65"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadBtn"
                                Content="Download"
                                Click="OnDownloadClicked"
                                IsEnabled="False"
                                Classes="accent" />
                        <Button x:Name="CloseBtn"
                                Content="Cancel"
                                Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

    </Panel>

</UserControl>
