<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Misa.Views.EditTrackWindow"
        Title="Edit Track" Width="480" Height="480"
        CanResize="False" WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveBtn" Content="Save" Click="OnSaveClicked" IsEnabled="False" />
            <Button Content="Cancel" Click="OnCancelClicked" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock Text="Title" />
                <TextBox x:Name="TitleBox" />

                <TextBlock Text="Genre" />
                <ComboBox x:Name="GenreBox" HorizontalAlignment="Stretch" />

                <TextBlock Text="Rating" />
                <ComboBox x:Name="RatingBox" HorizontalAlignment="Stretch" />

                <TextBlock Text="Styles (click to toggle)" />
                <ListBox x:Name="StylesBox" SelectionMode="Multiple,Toggle" Height="120" />

                <TextBlock Text="Notes" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="80"
                         TextWrapping="Wrap" Watermark="Optional notes…" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
