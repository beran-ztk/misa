<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Misa.Views.EditTrackWindow"
        Title="Edit Track" Width="480" Height="620"
        CanResize="False" WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveBtn" Content="Save" Click="OnSaveClicked" IsEnabled="False" />
            <Button Content="Cancel" Click="OnCancelClicked" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="10">

                <StackPanel Spacing="3">
                    <TextBlock Text="Title" FontSize="12" Opacity="0.75" />
                    <TextBox x:Name="TitleBox" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Genres" FontSize="12" Opacity="0.75" />
                    <ListBox x:Name="GenresBox" SelectionMode="Multiple,Toggle" MaxHeight="110"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Margin" Value="2,2,0,0" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>

                <StackPanel Spacing="3">
                    <TextBlock Text="Rating" FontSize="12" Opacity="0.75" />
                    <ComboBox x:Name="RatingBox" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Styles (optional)" FontSize="12" Opacity="0.75" />
                    <ListBox x:Name="StylesBox" SelectionMode="Multiple,Toggle" MaxHeight="100"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Margin" Value="2,2,0,0" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Languages (optional)" FontSize="12" Opacity="0.75" />
                    <ListBox x:Name="LanguagesBox" SelectionMode="Multiple,Toggle" MaxHeight="90"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Margin" Value="2,2,0,0" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>

                <CheckBox x:Name="ReEvalCheckBox" Content="Needs re-evaluation" Margin="0,2,0,0" />

                <StackPanel Spacing="3">
                    <TextBlock Text="Notes" FontSize="12" Opacity="0.75" />
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="80"
                             TextWrapping="Wrap" Watermark="Optional notes…" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
