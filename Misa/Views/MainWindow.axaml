<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Misa.Views.MainWindow"
        Title="Misa" Width="1300" Height="700">

    <Grid ColumnDefinitions="160,*">

        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#30808080" Padding="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Misa" FontWeight="Bold" FontSize="16" Margin="4,4,4,12" />
                <Button x:Name="NavMusicBtn" Content="Music"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnMusicClicked" />
                <Button x:Name="NavSettingsBtn" Content="Settings"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnSettingsClicked" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="ContentArea" />

    </Grid>

</Window>
