<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Misa.Views"
             xmlns:models="using:Misa.Models"
             x:Class="Misa.Views.MusicView">

    <DockPanel LastChildFill="True">

        <!-- Header row -->
        <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
            <TextBlock DockPanel.Dock="Left" Text="Music Library"
                       FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Add Track"
                    Click="OnAddTrackClicked" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Filter / Search / Sort -->
        <Border DockPanel.Dock="Top" Padding="16,6,16,10"
                BorderThickness="0,0,0,1" BorderBrush="#20808080">
            <StackPanel Spacing="6">

                <!-- Global filters + group button on one row -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+ Group"
                            Click="OnAddFilterGroupClicked"
                            Padding="10,3" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="2" MinWidth="130">
                            <TextBlock Text="Rating" FontSize="10" Opacity="0.5" />
                            <local:MultiSelectFilterControl x:Name="RatingFilter" />
                        </StackPanel>
                        <CheckBox x:Name="ReEvalFilterCheckBox" Content="Re-eval only"
                                  VerticalAlignment="Bottom" FontSize="12" />
                    </StackPanel>
                </DockPanel>

                <!-- Dynamic filter groups (populated in code-behind) -->
                <StackPanel x:Name="FilterGroupsPanel" Spacing="3" />

                <!-- Search + Sort -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Watermark="Search title or notes…" />
                    <ComboBox x:Name="SortFieldCombo" Grid.Column="1"
                              Margin="6,0,0,0" MinWidth="108" />
                    <ComboBox x:Name="SortDirectionCombo" Grid.Column="2"
                              Margin="4,0,0,0" MinWidth="86" />
                </Grid>

                <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap"
                           FontSize="11" Opacity="0.6" />

            </StackPanel>
        </Border>

        <!-- Player bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,10,16,10"
                BorderThickness="0,1,0,0" BorderBrush="#20808080">
            <StackPanel Spacing="5">

                <!-- Row 1: Now Playing + secondary options -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="AutoplayCheckBox" Content="Autoplay" FontSize="11" />
                        <CheckBox x:Name="CrossfadeCheckBox" Content="Crossfade" FontSize="11" />
                        <ComboBox x:Name="RepeatModeCombo" MinWidth="95" FontSize="11" />
                        <CheckBox x:Name="ShuffleCheckBox" Content="Shuffle" FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="NowPlayingText" Text="" FontStyle="Italic" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,14,0" />
                </DockPanel>

                <!-- Row 2: Progress bar (only shown during playback) -->
                <Grid x:Name="PlaybackInfoPanel" ColumnDefinitions="*,Auto" IsVisible="False">
                    <Slider x:Name="PlaybackSlider" Grid.Column="0"
                            Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlaybackTimeText" Grid.Column="1"
                               Text="" FontSize="11" Opacity="0.6"
                               Margin="10,0,0,0" MinWidth="86" VerticalAlignment="Center" />
                </Grid>

                <!-- Row 3: Transport buttons + volume -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="MuteCheckBox" Content="Mute" />
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                Width="90" VerticalAlignment="Center" />
                        <TextBlock x:Name="VolumeText" Text="100%" FontSize="11" Opacity="0.6"
                                   MinWidth="34" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Button Content="⏮" Click="OnPreviousClicked" />
                        <Button Content="▶" Click="OnPlayClicked" />
                        <Button x:Name="PauseResumeBtn" Content="Pause"
                                Click="OnPauseResumeClicked" IsVisible="False" />
                        <Button Content="⏹" Click="OnStopClicked" />
                        <Button Content="⏭" Click="OnNextClicked" />
                    </StackPanel>
                </DockPanel>

            </StackPanel>
        </Border>

        <!-- Upcoming track bar (above player bar) -->
        <Border x:Name="UpcomingBar" DockPanel.Dock="Bottom"
                Padding="16,5" IsVisible="False"
                BorderThickness="0,1,0,0" BorderBrush="#14808080">
            <DockPanel>
                <TextBlock x:Name="CrossfadeStatusText" DockPanel.Dock="Right"
                           FontSize="11" Opacity="0.45" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Opacity="0.45" Text="Next:" />
                    <TextBlock x:Name="UpcomingTrackText" FontSize="11" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Track list -->
        <ListBox x:Name="FileList" DoubleTapped="OnListDoubleTapped"
                 Padding="4,4,4,4">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TrackDisplayItem">
                    <Grid ColumnDefinitions="20,*">
                        <TextBlock Grid.Column="0" Text="▶" FontSize="10"
                                   VerticalAlignment="Center" Opacity="0.75"
                                   IsVisible="{Binding IsPlaying}" />
                        <StackPanel Grid.Column="1" Margin="0,4,0,4">
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                            <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.55"
                                       Margin="0,1,0,0" />
                            <TextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.45"
                                       FontStyle="Italic" IsVisible="{Binding HasNotes}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Click="OnContextEditClicked" />
                    <MenuItem Header="Delete" Click="OnContextDeleteClicked" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

    </DockPanel>

</UserControl>
