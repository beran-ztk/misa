<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Misa.Views"
             xmlns:models="using:Misa.Models"
             x:Class="Misa.Views.MusicView">

    <DockPanel Margin="12" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <Button Content="Add Track" Click="OnAddTrackClicked" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" />
        </StackPanel>

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#30808080"
                Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Spacing="3" MinWidth="160">
                    <TextBlock Text="Genre" FontSize="11" Opacity="0.6" />
                    <local:MultiSelectFilterControl x:Name="GenreFilter" />
                </StackPanel>
                <StackPanel Spacing="3" MinWidth="140">
                    <TextBlock Text="Rating" FontSize="11" Opacity="0.6" />
                    <local:MultiSelectFilterControl x:Name="RatingFilter" />
                </StackPanel>
                <StackPanel Spacing="3" MinWidth="160">
                    <TextBlock Text="Style" FontSize="11" Opacity="0.6" />
                    <local:MultiSelectFilterControl x:Name="StyleFilter" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Play" Click="OnPlayClicked" />
                <Button x:Name="PauseResumeBtn" Content="Pause"
                        Click="OnPauseResumeClicked" IsVisible="False" />
                <Button Content="Stop" Click="OnStopClicked" />
                <TextBlock x:Name="NowPlayingText" Text="" FontStyle="Italic"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="PlaybackInfoPanel" Spacing="3" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <Slider x:Name="PlaybackSlider" Grid.Column="0"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="PlaybackTimeText" Grid.Column="1"
                               Text="" FontSize="11" Opacity="0.7"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="FileList" DoubleTapped="OnListDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TrackDisplayItem">
                    <Grid ColumnDefinitions="18,*">
                        <TextBlock Grid.Column="0" Text="▶" FontSize="9"
                                   VerticalAlignment="Center" Opacity="0.8"
                                   IsVisible="{Binding IsPlaying}" />
                        <StackPanel Grid.Column="1" Margin="0,2">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Click="OnContextEditClicked" />
                    <MenuItem Header="Delete" Click="OnContextDeleteClicked" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

    </DockPanel>

</UserControl>
