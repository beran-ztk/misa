<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Misa.Views"
             xmlns:models="using:Misa.Models"
             x:Class="Misa.Views.MusicView">

    <DockPanel LastChildFill="True">

        <!-- Header row: title + action buttons -->
        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
            <TextBlock DockPanel.Dock="Left" Text="Music Library"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Add Track"
                    Click="OnAddTrackClicked" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Filter / Search / Sort area -->
        <Border DockPanel.Dock="Top" Padding="16,0,16,10"
                BorderThickness="0,0,0,1" BorderBrush="#20808080">
            <StackPanel Spacing="8">

                <!-- Global filters row: Rating + ReEval + Add Group button -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+ Group"
                            Click="OnAddFilterGroupClicked"
                            Padding="8,4" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="2" MinWidth="130">
                            <TextBlock Text="Rating" FontSize="11" Opacity="0.55" />
                            <local:MultiSelectFilterControl x:Name="RatingFilter" />
                        </StackPanel>
                        <CheckBox x:Name="ReEvalFilterCheckBox"
                                  Content="Re-eval needed"
                                  VerticalAlignment="Bottom" />
                    </StackPanel>
                </DockPanel>

                <!-- Filter groups (populated dynamically in code-behind) -->
                <StackPanel x:Name="FilterGroupsPanel" Spacing="4" />

                <!-- Search + Sort row -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Watermark="Search title or notes…" />
                    <ComboBox x:Name="SortFieldCombo" Grid.Column="1"
                              Margin="8,0,0,0" MinWidth="120" />
                    <ComboBox x:Name="SortDirectionCombo" Grid.Column="2"
                              Margin="4,0,0,0" MinWidth="96" />
                </Grid>

                <!-- Status / feedback line -->
                <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap"
                           FontSize="11" Opacity="0.65" />

            </StackPanel>
        </Border>

        <!-- Player bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="#20808080">
            <StackPanel Spacing="5">

                <!-- Transport + Playback options + Volume + Now Playing -->
                <DockPanel>
                    <!-- Transport buttons -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="3">
                        <Button Content="⏮" Click="OnPreviousClicked" />
                        <Button Content="▶" Click="OnPlayClicked" />
                        <Button x:Name="PauseResumeBtn" Content="Pause"
                                Click="OnPauseResumeClicked" IsVisible="False" />
                        <Button Content="⏹" Click="OnStopClicked" />
                        <Button Content="⏭" Click="OnNextClicked" />
                    </StackPanel>

                    <!-- Autoplay / Repeat / Shuffle -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <CheckBox x:Name="AutoplayCheckBox" Content="Autoplay" />
                        <ComboBox x:Name="RepeatModeCombo" MinWidth="105" />
                        <CheckBox x:Name="ShuffleCheckBox" Content="Shuffle" />
                    </StackPanel>

                    <!-- Mute + Volume -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <CheckBox x:Name="MuteCheckBox" Content="Mute" />
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                Width="90" VerticalAlignment="Center" />
                        <TextBlock x:Name="VolumeText" Text="100%" FontSize="11" Opacity="0.6"
                                   MinWidth="34" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Now Playing (fills remaining width) -->
                    <TextBlock x:Name="NowPlayingText" Text="" FontStyle="Italic"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="14,0,0,0" Opacity="0.75" />
                </DockPanel>

                <!-- Progress row: full width, only shown during playback -->
                <Grid x:Name="PlaybackInfoPanel" ColumnDefinitions="*,Auto" IsVisible="False">
                    <Slider x:Name="PlaybackSlider" Grid.Column="0"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="PlaybackTimeText" Grid.Column="1"
                               Text="" FontSize="11" Opacity="0.6"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Track list (fills remaining space) -->
        <ListBox x:Name="FileList" DoubleTapped="OnListDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TrackDisplayItem">
                    <Grid ColumnDefinitions="18,*">
                        <TextBlock Grid.Column="0" Text="▶" FontSize="9"
                                   VerticalAlignment="Center" Opacity="0.8"
                                   IsVisible="{Binding IsPlaying}" />
                        <StackPanel Grid.Column="1" Margin="0,3">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.55" />
                            <TextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.45"
                                       FontStyle="Italic" IsVisible="{Binding HasNotes}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Click="OnContextEditClicked" />
                    <MenuItem Header="Delete" Click="OnContextDeleteClicked" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

    </DockPanel>

</UserControl>
