<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Misa.Views.SettingsView">

    <ScrollViewer>
        <StackPanel Margin="20,16,20,24" Spacing="0">

            <!-- Section: Storage & Tools -->
            <TextBlock Text="Storage &amp; Tools" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Music directory"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="MusicDirBox" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse"
                        Click="OnBrowseMusicDirClicked" Margin="8,0,0,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tools directory"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ToolsDirBox" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse"
                        Click="OnBrowseToolsDirClicked" Margin="8,0,0,0" />
            </Grid>

            <Border BorderThickness="0,0,0,1" BorderBrush="#20808080" Margin="0,20,0,20" />

            <!-- Section: Download Options -->
            <TextBlock Text="Download Options" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <StackPanel Spacing="6">
                <CheckBox x:Name="UseNodeJsCheckBox" Content="Use Node.js runtime" />
                <CheckBox x:Name="UseFirefoxCheckBox" Content="Use Firefox cookies" />
                <CheckBox x:Name="UseRemoteEjsCheckBox" Content="Use remote EJS components" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,4">
                <Button Content="Save Settings" Click="OnSaveSettingsClicked" />
                <Button Content="Test Tools" Click="OnTestToolsClicked" />
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Text="" FontSize="11" Opacity="0.65"
                       TextWrapping="Wrap" />

            <Border BorderThickness="0,0,0,1" BorderBrush="#20808080" Margin="0,24,0,20" />

            <!-- Section: Metadata -->
            <TextBlock Text="Metadata" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">

                <!-- Genres -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Genres" FontWeight="SemiBold" />
                    <ListBox x:Name="GenreList" Height="140" SelectionChanged="OnGenreSelected" />
                    <TextBox x:Name="GenreInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddGenreClicked" />
                        <Button Content="Rename" Click="OnRenameGenreClicked" />
                        <Button Content="Delete" Click="OnDeleteGenreClicked" />
                    </StackPanel>
                    <TextBlock x:Name="GenreStatus" Text="" FontSize="11" Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Styles -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Styles" FontWeight="SemiBold" />
                    <ListBox x:Name="StyleList" Height="140" SelectionChanged="OnStyleSelected" />
                    <TextBox x:Name="StyleInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddStyleClicked" />
                        <Button Content="Rename" Click="OnRenameStyleClicked" />
                        <Button Content="Delete" Click="OnDeleteStyleClicked" />
                    </StackPanel>
                    <TextBlock x:Name="StyleStatus" Text="" FontSize="11" Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Ratings -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Ratings" FontWeight="SemiBold" />
                    <ListBox x:Name="RatingList" Height="140" SelectionChanged="OnRatingSelected" />
                    <TextBox x:Name="RatingInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddRatingClicked" />
                        <Button Content="Rename" Click="OnRenameRatingClicked" />
                        <Button Content="Delete" Click="OnDeleteRatingClicked" />
                    </StackPanel>
                    <TextBlock x:Name="RatingStatus" Text="" FontSize="11" Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
