<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Misa.Views.SettingsView">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="4">

            <TextBlock Text="Music Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Music directory"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="MusicDirBox" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse"
                        Click="OnBrowseMusicDirClicked" Margin="6,0,0,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tools directory"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ToolsDirBox" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse"
                        Click="OnBrowseToolsDirClicked" Margin="6,0,0,0" />

                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="UseNodeJsCheckBox"
                          Content="Use Node.js runtime" />
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="UseFirefoxCheckBox"
                          Content="Use Firefox cookies" />
                <CheckBox Grid.Row="4" Grid.Column="1" x:Name="UseRemoteEjsCheckBox"
                          Content="Use remote EJS components" />

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Save Settings" Click="OnSaveSettingsClicked" />
                    <Button Content="Test Tools" Click="OnTestToolsClicked" />
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SettingsStatus"
                           Text="" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </Grid>

            <Border BorderThickness="0,0,0,1" BorderBrush="#30808080" Margin="0,16,0,12" />

            <TextBlock Text="Metadata" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">

                <!-- Genres -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Genres" FontWeight="SemiBold" />
                    <ListBox x:Name="GenreList" Height="130" SelectionChanged="OnGenreSelected" />
                    <TextBox x:Name="GenreInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddGenreClicked" />
                        <Button Content="Rename" Click="OnRenameGenreClicked" />
                        <Button Content="Delete" Click="OnDeleteGenreClicked" />
                    </StackPanel>
                    <TextBlock x:Name="GenreStatus" Text="" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Styles -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Styles" FontWeight="SemiBold" />
                    <ListBox x:Name="StyleList" Height="130" SelectionChanged="OnStyleSelected" />
                    <TextBox x:Name="StyleInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddStyleClicked" />
                        <Button Content="Rename" Click="OnRenameStyleClicked" />
                        <Button Content="Delete" Click="OnDeleteStyleClicked" />
                    </StackPanel>
                    <TextBlock x:Name="StyleStatus" Text="" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Ratings -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Ratings" FontWeight="SemiBold" />
                    <ListBox x:Name="RatingList" Height="130" SelectionChanged="OnRatingSelected" />
                    <TextBox x:Name="RatingInput" Watermark="Name…" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Add" Click="OnAddRatingClicked" />
                        <Button Content="Rename" Click="OnRenameRatingClicked" />
                        <Button Content="Delete" Click="OnDeleteRatingClicked" />
                    </StackPanel>
                    <TextBlock x:Name="RatingStatus" Text="" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
